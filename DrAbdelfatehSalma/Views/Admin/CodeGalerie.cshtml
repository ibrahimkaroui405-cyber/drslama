@model DrAbdelfatehSalma.Models.SiteSetting
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Code d'accès Galerie";
    var currentCode = Model?.Value ?? "";
    var updatedAt = Model?.UpdatedAt;
}

<div class="max-w-3xl mx-auto space-y-8">
    <div class="border-b border-gold/20 pb-6">
        <h1 class="font-display-lg text-2xl font-bold text-white mb-1">Code d'accès — Galerie Avant / Après</h1>
        <p class="text-xs text-gray-400">Changez à tout moment le code confidentiel que vous communiquez aux patients. Le nouveau code est actif immédiatement et l'ancien ne fonctionne plus.</p>
    </div>

    <!-- Current code -->
    <section class="bg-[#121419] p-8 border border-gold/20 shadow-xl space-y-4">
        <div class="flex items-center gap-2 text-gold text-xs font-bold uppercase tracking-wider">
            <span class="material-symbols-outlined text-base">lock</span>
            <span>Code actuel</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <input type="password" id="current-code" value="@currentCode" readonly
                   class="flex-1 p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-sm font-mono tracking-widest focus:outline-none" />
            <div class="flex gap-2">
                <button type="button" id="btn-toggle-current" onclick="toggleCurrentCode()"
                        class="px-4 py-3 border border-gold/30 text-gold text-xs font-bold hover:bg-gold/10 transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm" id="toggle-icon">visibility</span>
                    <span id="toggle-label">Afficher</span>
                </button>
                <button type="button" id="btn-copy-current" onclick="copyCurrentCode()"
                        class="px-4 py-3 border border-gold/30 text-gold text-xs font-bold hover:bg-gold/10 transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">content_copy</span>
                    <span id="copy-label">Copier</span>
                </button>
            </div>
        </div>

        @if (updatedAt.HasValue)
        {
            <p class="text-[11px] text-gray-500">Dernière modification : @updatedAt.Value.ToString("dd/MM/yyyy à HH:mm")</p>
        }
    </section>

    <!-- Change code -->
    <form asp-controller="Admin" asp-action="CodeGalerie" method="post" id="form-change-code"
          class="bg-[#121419] p-8 border border-gold/20 shadow-xl space-y-6">

        <div class="flex items-center gap-2 text-gold text-xs font-bold uppercase tracking-wider">
            <span class="material-symbols-outlined text-base">key</span>
            <span>Définir un nouveau code</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="newCode" class="block text-xs font-bold text-gold uppercase mb-2">Nouveau code *</label>
                <input type="text" id="newCode" name="newCode" required minlength="6" maxlength="100" autocomplete="off"
                       placeholder="Ex: slama-galerie-nov26"
                       class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs font-mono focus:outline-none focus:border-gold" />
            </div>
            <div>
                <label for="confirmCode" class="block text-xs font-bold text-gold uppercase mb-2">Confirmer le code *</label>
                <input type="text" id="confirmCode" name="confirmCode" required minlength="6" maxlength="100" autocomplete="off"
                       placeholder="Retapez le même code"
                       class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs font-mono focus:outline-none focus:border-gold" />
            </div>
        </div>

        <p id="code-mismatch" class="hidden text-xs text-red-400 font-bold">Les deux codes ne correspondent pas.</p>

        <div class="text-[11px] text-gray-500 space-y-1">
            <p>• Minimum 6 caractères. Les majuscules/minuscules ne sont pas distinguées pour le patient.</p>
            <p>• Après le changement, les patients qui ont l'ancien code devront vous demander le nouveau.</p>
        </div>

        <div class="pt-4 border-t border-gold/20 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <button type="button" id="btn-generate-code" onclick="generateCode()"
                    class="px-5 py-3 border border-gold/30 text-gold text-xs font-bold hover:bg-gold/10 transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-sm">casino</span>
                Générer un code aléatoire
            </button>
            <button type="submit" id="btn-save-code"
                    class="gold-gradient text-white font-label-caps text-xs py-4 px-8 hover:opacity-90 font-bold tracking-widest shadow flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-sm">save</span>
                ENREGISTRER LE NOUVEAU CODE
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function toggleCurrentCode() {
        const input = document.getElementById('current-code');
        const icon = document.getElementById('toggle-icon');
        const label = document.getElementById('toggle-label');
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        icon.textContent = show ? 'visibility_off' : 'visibility';
        label.textContent = show ? 'Masquer' : 'Afficher';
    }

    async function copyCurrentCode() {
        const value = document.getElementById('current-code').value;
        const label = document.getElementById('copy-label');
        try {
            await navigator.clipboard.writeText(value);
            label.textContent = 'Copié ✓';
        } catch {
            label.textContent = 'Échec';
        }
        setTimeout(() => label.textContent = 'Copier', 1800);
    }

    function generateCode() {
        const words = ['slama', 'galerie', 'sousse', 'clinique', 'resultats', 'acces'];
        const chars = 'abcdefghjkmnpqrstuvwxyz23456789';
        const rnd = new Uint32Array(7);
        crypto.getRandomValues(rnd);
        let suffix = '';
        for (let i = 1; i < 7; i++) suffix += chars[rnd[i] % chars.length];
        const code = `${words[rnd[0] % words.length]}-${suffix}`;
        document.getElementById('newCode').value = code;
        document.getElementById('confirmCode').value = code;
        document.getElementById('code-mismatch').classList.add('hidden');
    }

    document.getElementById('form-change-code').addEventListener('submit', function (e) {
        const a = document.getElementById('newCode').value.trim();
        const b = document.getElementById('confirmCode').value.trim();
        const msg = document.getElementById('code-mismatch');
        if (a !== b) {
            e.preventDefault();
            msg.classList.remove('hidden');
            return;
        }
        if (!confirm('Confirmer le changement ? L\'ancien code ne fonctionnera plus pour les patients.')) {
            e.preventDefault();
        }
    });
</script>
}
