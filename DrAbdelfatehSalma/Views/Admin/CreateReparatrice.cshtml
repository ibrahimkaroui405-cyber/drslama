@model DrAbdelfatehSalma.Models.Reparatrice
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ajouter une Chirurgie Réparatrice";
}

<div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gold/20 pb-6 flex items-center justify-between">
        <div>
            <h1 class="font-display-lg text-2xl font-bold text-white mb-1">Ajouter une Chirurgie Réparatrice</h1>
            <p class="text-xs text-gray-400">Renseignez les détails de la nouvelle fiche de chirurgie réparatrice.</p>
        </div>
        <a asp-controller="Admin" asp-action="Reparatrice" class="text-xs text-gray-400 hover:text-white flex items-center gap-1 font-bold">
            ← Annuler et retourner
        </a>
    </div>

    <form asp-controller="Admin" asp-action="CreateReparatrice" method="post" enctype="multipart/form-data" class="space-y-6 bg-[#121419] p-8 border border-gold/20 shadow-xl">
        @Html.AntiForgeryToken()
        
        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">TITRE DE LA CARTE *</label>
            <input type="text" asp-for="Title" required placeholder="Ex: Malformations" class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" />
        </div>

        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">SOUS-TITRE EN ITALIQUE (AFFICHÉ SOUS LE TITRE) *</label>
            <input type="text" asp-for="Subtitle" required placeholder="Ex: Surtout des lèvres, du nez et des oreilles." class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" />
        </div>

        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">DESCRIPTION PRINCIPALE DE LA CARTE *</label>
            <textarea asp-for="Overview" rows="4" required placeholder="Description détaillée du domaine réparateur..." class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold leading-relaxed"></textarea>
        </div>

        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">BADGES / MOTS-CLÉS (SÉPARÉS PAR DES POINTS-VIRGULES)</label>
            <input type="text" asp-for="Indications" placeholder="Ex: Lèvres & Nez; Oreilles; Symétrie" class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" />
            <span class="text-[10px] text-gray-500 block mt-1">Chaque mot-clé séparé par un point-virgule (;) apparaîtra sous forme d'étiquette au bas de la carte.</span>
        </div>

        <div class="pt-4 border-t border-gold/20 flex justify-end">
            <button type="submit" class="gold-gradient text-white font-label-caps text-xs py-4 px-8 hover:opacity-90 font-bold tracking-widest shadow">
                AJOUTER LA CARTE AU SITE PUBLIC
            </button>
        </div>

    </form>
</div>
