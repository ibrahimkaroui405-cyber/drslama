@model DrAbdelfatehSalma.Models.Esthetique
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ajouter un Soin Esthétique";
}

<div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gold/20 pb-6 flex items-center justify-between">
        <div>
            <h1 class="font-display-lg text-2xl font-bold text-white mb-1">Ajouter un Soin Esthétique</h1>
            <p class="text-xs text-gray-400">Renseignez les détails du traitement de médecine esthétique.</p>
        </div>
        <a asp-controller="Admin" asp-action="Esthetique" class="text-xs text-gray-400 hover:text-white flex items-center gap-1 font-bold">
            ← Annuler et retourner
        </a>
    </div>

    <form asp-controller="Admin" asp-action="CreateEsthetique" method="post" enctype="multipart/form-data" class="space-y-6 bg-[#121419] p-8 border border-gold/20 shadow-xl">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">TITRE DU SOIN *</label>
                <input type="text" asp-for="Title" id="title-input" required placeholder="Ex: Injections Acide Hyaluronique HD" class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" oninput="onTitleInput(this.value)" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">IDENTIFIANT URL (SLUG) *</label>
                <input type="text" asp-for="Slug" id="slug-input" required placeholder="Ex: acide-hyaluronique" class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">IMAGE PRINCIPALE</label>
                <input type="file" name="imageFile" accept="image/*" class="w-full p-2 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
                <input type="text" asp-for="ImageUrl" placeholder="Ou URL image (/images/...)" class="w-full p-3.5 mt-2 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">SOUS-TITRE / RÉSUMÉ COURT</label>
                <input type="text" asp-for="Subtitle" placeholder="Restructuration des volumes, comblement..." class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-[10px] font-bold text-gold uppercase mb-2">DURÉE</label>
                <input type="text" asp-for="Duree" placeholder="Ex: 30 – 45 min" class="w-full p-3 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-bold text-gold uppercase mb-2">ANESTHÉSIE</label>
                <input type="text" asp-for="Anesthesie" placeholder="Ex: Crème Lidocaïne" class="w-full p-3 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-bold text-gold uppercase mb-2">ÉVICTION</label>
                <input type="text" asp-for="Eviction" placeholder="Ex: Immédiate" class="w-full p-3 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>
            <div>
                <label class="block text-[10px] font-bold text-gold uppercase mb-2">LIEU / CADRE</label>
                <input type="text" asp-for="Hospitalisation" placeholder="Ex: Cabinet Médical" class="w-full p-3 bg-[#0c0d10] border border-gold/20 text-white text-xs" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">PRÉSENTATION & APPROCHE MÉDICALE</label>
            <textarea asp-for="Overview" rows="4" placeholder="Description détaillée..." class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs"></textarea>
        </div>

        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">QUESTIONS FREQUENTES (Question ? Réponse ; Question ? Réponse)</label>
            <textarea asp-for="Faqs" rows="3" placeholder="Durée du résultat ? 12 à 18 mois.;Est-ce douloureux ? Inconfort minimal." class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs"></textarea>
        </div>

        <div class="pt-4 border-t border-gold/20 flex justify-end">
            <button type="submit" class="gold-gradient text-white font-label-caps text-xs py-4 px-8 hover:opacity-90 font-bold tracking-widest shadow">
                ENREGISTRER LE SOIN ESTHÉTIQUE
            </button>
        </div>

    </form>
</div>

<script>
    function onTitleInput(val) {
        const slugInput = document.getElementById('slug-input');
        if (slugInput && (!slugInput.value || slugInput.dataset.auto === 'true')) {
            slugInput.value = val.toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
            slugInput.dataset.auto = 'true';
        }
    }
</script>
