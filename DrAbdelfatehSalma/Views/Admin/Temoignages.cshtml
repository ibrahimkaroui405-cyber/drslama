@model IEnumerable<DrAbdelfatehSalma.Models.Temoignage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestion des Témoignages Patients";
}

<div class="space-y-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gold/20 pb-6">
        <div>
            <h1 class="font-display-lg text-2xl font-bold text-white mb-1">Témoignages & Avis Patients</h1>
            <p class="text-xs text-gray-400">Gérer les récits d'expérience, vidéos et avis écrits de la patientèle.</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTemoignage" class="gold-gradient text-white font-label-caps text-xs py-3 px-5 hover:opacity-90 transition-all font-bold tracking-widest flex items-center gap-2 shadow">
            <span class="material-symbols-outlined text-sm">rate_review</span>
            <span>AJOUTER UN TÉMOIGNAGE</span>
        </a>
    </div>

    <div class="bg-[#121419] border border-gold/20 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-300">
                <thead class="bg-[#0c0d10] text-gold font-label-caps text-[10px] uppercase border-b border-gold/20">
                    <tr>
                        <th class="p-4">Patient</th>
                        <th class="p-4">Type</th>
                        <th class="p-4">Procédure & Suivi</th>
                        <th class="p-4">Note</th>
                        <th class="p-4">Citation / Avis</th>
                        <th class="p-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="p-4 font-bold text-white">
                                    @item.PatientName
                                    <span class="block text-[10px] text-gray-500 font-normal">@item.PatientInfo</span>
                                </td>
                                <td class="p-4">
                                    @if (item.Type == "video")
                                    {
                                        <span class="px-2.5 py-1 rounded bg-purple-500/10 text-purple-400 text-[10px] font-bold border border-purple-500/30 flex items-center gap-1 w-fit">
                                            <span class="material-symbols-outlined text-xs">play_circle</span> VIDÉO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded bg-blue-500/10 text-blue-400 text-[10px] font-bold border border-blue-500/30 flex items-center gap-1 w-fit">
                                            <span class="material-symbols-outlined text-xs">article</span> ÉCRIT
                                        </span>
                                    }
                                </td>
                                <td class="p-4 text-gold font-bold">@item.FollowUpTime</td>
                                <td class="p-4 text-amber-400">
                                    @for (int i = 0; i < item.Rating; i++)
                                    {
                                        <span>★</span>
                                    }
                                </td>
                                <td class="p-4 max-w-xs truncate text-gray-300">"@item.Quote"</td>
                                <td class="p-4 text-right space-x-2">
                                    <a asp-controller="Admin" asp-action="EditTemoignage" asp-route-id="@item.Id" class="px-3 py-1.5 bg-gold/20 text-gold hover:bg-gold hover:text-white rounded text-[11px] font-bold transition-all inline-block">
                                        Éditer
                                    </a>
                                    <form asp-controller="Admin" asp-action="DeleteTemoignage" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce témoignage ?');">
                                        <button type="submit" class="px-3 py-1.5 bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white rounded text-[11px] font-bold transition-all">
                                            Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-gray-500 italic">Aucun témoignage enregistré.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
