@{
    Layout = null;
    ViewData["Title"] = "Connexion Administrateur — Dr. Abdelfateh Slama";
}
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,200..700,0..1,-50..200" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gold-gradient {
            background: linear-gradient(135deg, #c2a878 0%, #d9c69d 50%, #c2a878 100%);
        }
        .gold-glow {
            box-shadow: 0 0 40px rgba(194,168,120,0.25);
        }
        .gold-border {
            border: 1px solid #c2a878;
        }
    </style>
</head>
<body class="bg-[#08090b] text-white font-sans antialiased min-h-screen flex items-center justify-center p-6 relative overflow-hidden">

    <!-- Ambient background glow -->
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-[#c2a878]/10 blur-[140px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-[#c2a878]/10 blur-[140px] pointer-events-none"></div>

    <div class="w-full max-w-md bg-[#121419] p-8 md:p-10 border border-[#c2a878]/30 shadow-2xl gold-glow relative z-10">
        
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-full gold-gradient text-white flex items-center justify-center mx-auto mb-4 shadow-lg">
                <span class="material-symbols-outlined text-3xl">lock</span>
            </div>
            <h1 class="font-display-lg text-2xl font-bold text-white mb-1">DR. ABDELFATEH SLAMA</h1>
            <span class="font-label-caps text-[10px] text-gold tracking-[0.3em] font-bold block uppercase">ESPACE D'ADMINISTRATION CLINIQUE</span>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 rounded bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold text-center">
                @ViewData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Admin" asp-action="Login" method="post" class="space-y-6">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div>
                <label class="block font-label-caps text-[10px] font-bold text-gold tracking-widest uppercase mb-2">IDENTIFIANT *</label>
                <div class="relative">
                    <span class="material-symbols-outlined text-gray-400 absolute left-4 top-3.5 text-lg">person</span>
                    <input type="text" name="username" required placeholder="Ex: admin" class="w-full pl-12 pr-4 py-3.5 bg-[#0c0d10] border border-gold/20 text-white font-body-md text-sm focus:outline-none focus:border-gold transition-all" />
                </div>
            </div>

            <div>
                <label class="block font-label-caps text-[10px] font-bold text-gold tracking-widest uppercase mb-2">MOT DE PASSE *</label>
                <div class="relative">
                    <span class="material-symbols-outlined text-gray-400 absolute left-4 top-3.5 text-lg">key</span>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full pl-12 pr-4 py-3.5 bg-[#0c0d10] border border-gold/20 text-white font-body-md text-sm focus:outline-none focus:border-gold transition-all" />
                </div>
            </div>

            <button type="submit" class="w-full gold-gradient text-white font-label-caps text-xs py-4 hover:opacity-90 transition-all font-bold tracking-widest shadow-xl uppercase">
                SE CONNECTER À L'ADMINISTRATION
            </button>

            <div class="pt-4 border-t border-gold/20 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-xs text-gray-400 hover:text-white transition-colors">← Retourner au site public</a>
            </div>
        </form>

    </div>

</body>
</html>
