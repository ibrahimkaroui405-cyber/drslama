@model DrAbdelfatehSalma.Models.Resultat
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nouveau Cas Clinique Avant/Après";
}

<div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gold/20 pb-6 flex items-center justify-between">
        <div>
            <h1 class="font-display-lg text-2xl font-bold text-white mb-1">Ajouter un Cas Avant / Après</h1>
            <p class="text-xs text-gray-400">Publier une nouvelle étude de cas comparatif dans la galerie résultats.</p>
        </div>
        <a asp-controller="Admin" asp-action="Resultats" class="text-xs text-gray-400 hover:text-white flex items-center gap-1 font-bold">
            ← Annuler et retourner
        </a>
    </div>

    <form asp-controller="Admin" asp-action="CreateResultat" method="post" enctype="multipart/form-data" class="space-y-6 bg-[#121419] p-8 border border-gold/20 shadow-xl">
        
        <div>
            <label class="block text-xs font-bold text-gold uppercase mb-2">TITRE DU CAS *</label>
            <input type="text" asp-for="Title" required placeholder="Ex: Rhinoplastie Primaire Ultrasonique" class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">CATÉGORIE PRINCIPALE *</label>
                <select asp-for="CategoryKey" id="category-select" required class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold cursor-pointer">
                    <option value="visage">CHIRURGIE DU VISAGE</option>
                    <option value="poitrine">CHIRURGIE DU SEIN (POITRINE)</option>
                    <option value="silhouette">CHIRURGIE DE LA SILHOUETTE</option>
                </select>
                <input type="hidden" asp-for="CategoryTitle" id="category-title-input" value="@(string.IsNullOrEmpty(Model.CategoryTitle) ? "CHIRURGIE DU VISAGE" : Model.CategoryTitle)" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">SOUS-CATÉGORIE (INTERVENTION) *</label>
                <select asp-for="SubCategoryKey" id="subcategory-select" required class="w-full p-3.5 bg-[#0c0d10] border border-gold/20 text-white text-xs focus:outline-none focus:border-gold cursor-pointer">
                    <!-- Options populated dynamically based on selected category -->
                </select>
                <input type="hidden" asp-for="SubCategoryTitle" id="subcategory-title-input" value="@(string.IsNullOrEmpty(Model.SubCategoryTitle) ? "Rhinoplastie" : Model.SubCategoryTitle)" />
            </div>
        </div>

        <!-- Before & After Images Upload -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-[#0c0d10] border border-gold/20 rounded">
            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">📷 PHOTO AVANT (FICHIER OU URL)</label>
                <input type="file" name="beforeFile" accept="image/*" class="w-full p-2 bg-[#121419] border border-gold/20 text-white text-xs" />
                <input type="text" asp-for="BeforeImageUrl" placeholder="Ou URL (/images/rhino_before.png)" class="w-full p-3.5 mt-2 bg-[#121419] border border-gold/20 text-white text-xs" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gold uppercase mb-2">✨ PHOTO APRÈS (FICHIER OU URL)</label>
                <input type="file" name="afterFile" accept="image/*" class="w-full p-2 bg-[#121419] border border-gold/20 text-white text-xs" />
                <input type="text" asp-for="AfterImageUrl" placeholder="Ou URL (/images/rhino_after.png)" class="w-full p-3.5 mt-2 bg-[#121419] border border-gold/20 text-white text-xs" />
            </div>
        </div>

        <div class="pt-4 border-t border-gold/20 flex items-center justify-end">
            <button type="submit" class="gold-gradient text-white font-label-caps text-xs py-4 px-8 hover:opacity-90 font-bold tracking-widest shadow">
                ENREGISTRER LE CAS CLINIQUE
            </button>
        </div>

    </form>
</div>

@section Scripts {
<script>
    const categoryTaxonomy = {
        visage: {
            title: "CHIRURGIE DU VISAGE",
            subCategories: [
                { key: "rhinoplastie", title: "Rhinoplastie" },
                { key: "lifting-visage", title: "Lifting visage" },
                { key: "blepharoplastie", title: "Blépharoplastie" },
                { key: "genioplastie", title: "Génioplastie" },
                { key: "otoplastie", title: "Otoplastie" }
            ]
        },
        poitrine: {
            title: "CHIRURGIE DU SEIN (POITRINE)",
            subCategories: [
                { key: "augmentation-mammaire", title: "Augmentation Mammaire" },
                { key: "reduction-mammaire", title: "Réduction Mammaire" },
                { key: "lifting-seins", title: "Lifting des seins" }
            ]
        },
        silhouette: {
            title: "CHIRURGIE DE LA SILHOUETTE",
            subCategories: [
                { key: "liposuccion", title: "Liposuccion" },
                { key: "abdominoplastie", title: "Abdominoplastie" },
                { key: "lifting-bras", title: "Lifting des bras" }
            ]
        }
    };

    const catSelect = document.getElementById('category-select');
    const subSelect = document.getElementById('subcategory-select');
    const catTitleInput = document.getElementById('category-title-input');
    const subTitleInput = document.getElementById('subcategory-title-input');

    let initialSub = "@(Model.SubCategoryKey ?? "")";

    function updateSubCategories(preselectedSub) {
        const catKey = catSelect.value;
        const catData = categoryTaxonomy[catKey];
        if (!catData) return;

        catTitleInput.value = catData.title;

        subSelect.innerHTML = '';
        catData.subCategories.forEach((sub, idx) => {
            const opt = document.createElement('option');
            opt.value = sub.key;
            opt.textContent = sub.title;
            if (preselectedSub ? sub.key === preselectedSub : idx === 0) {
                opt.selected = true;
            }
            subSelect.appendChild(opt);
        });

        syncSubCategoryTitle();
    }

    function syncSubCategoryTitle() {
        if (subSelect.selectedIndex >= 0) {
            subTitleInput.value = subSelect.options[subSelect.selectedIndex].text;
        }
    }

    catSelect.addEventListener('change', () => {
        updateSubCategories();
    });

    subSelect.addEventListener('change', syncSubCategoryTitle);

    document.addEventListener('DOMContentLoaded', () => {
        updateSubCategories(initialSub);
    });
</script>
}
