<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin Dr. Abdelfateh Slama</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/favicon.png" />

    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,200..700,0..1,-50..200" />

    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        gold: "#c2a878",
                        "gold-light": "#d9c69d",
                        "gold-dark": "#9e8657",
                        primary: "#000000"
                    }
                }
            }
        }
    </script>
    <style>
        .gold-gradient {
            background: linear-gradient(135deg, #c2a878 0%, #d9c69d 50%, #c2a878 100%);
        }
        .gold-glow {
            box-shadow: 0 0 30px rgba(194,168,120,0.2);
        }
        .gold-border {
            border: 1px solid #c2a878;
        }
        .gold-border-light {
            border: 1px solid rgba(194,168,120,0.3);
        }
    </style>
</head>
<body class="bg-[#0c0d10] text-gray-100 font-sans antialiased min-h-screen flex flex-col md:flex-row">

    <!-- Admin Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-[#121419] border-r border-gold/20 flex flex-col justify-between flex-shrink-0 z-30">
        <div>
            <!-- Sidebar Header / Brand -->
            <div class="p-6 border-b border-gold/20 flex items-center gap-3">
                <img src="~/images/logo.png" alt="Logo" class="w-10 h-10 rounded-full border border-gold/40 bg-white p-0.5 object-cover flex-shrink-0" />
                <div>
                    <h1 class="font-display-lg text-base font-bold text-white tracking-wide">PR. SLAMA</h1>
                    <span class="text-[8.5px] font-label-caps text-gold tracking-wider block font-bold">ESPACE ADMINISTRATION</span>
                </div>
            </div>

            <!-- Nav Links -->
            <nav class="p-4 space-y-1.5 text-xs font-medium">
                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Dashboard" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">dashboard</span>
                    <span>Tableau de Bord</span>
                </a>
                
                <a asp-controller="Admin" asp-action="Chirurgies" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Chirurgies" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">medical_services</span>
                    <span>Chirurgie Esthétique</span>
                </a>

                <a asp-controller="Admin" asp-action="Reparatrice" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Reparatrice" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">healing</span>
                    <span>Chirurgie Réparatrice</span>
                </a>

                <a asp-controller="Admin" asp-action="Esthetique" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Esthetique" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">auto_awesome</span>
                    <span>Médecine Esthétique</span>
                </a>

                <a asp-controller="Admin" asp-action="Resultats" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Resultats" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">photo_library</span>
                    <span>Résultats (Avant/Après)</span>
                </a>

                <a asp-controller="Admin" asp-action="Temoignages" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Temoignages" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">rate_review</span>
                    <span>Témoignages</span>
                </a>

                <a asp-controller="Admin" asp-action="Actualites" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "Actualites" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">newspaper</span>
                    <span>Actualités &amp; Presse</span>
                </a>

                <a asp-controller="Admin" asp-action="RendezVous" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors hover:bg-gold/10 hover:text-gold @(ViewData["ActiveNav"]?.ToString() == "RendezVous" ? "bg-gold/15 text-gold font-bold border-l-4 border-gold" : "text-gray-300")">
                    <span class="material-symbols-outlined text-lg">calendar_month</span>
                    <span>Demandes de RDV</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-gold/20 space-y-2">
            <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center gap-2 px-4 py-2.5 rounded text-xs text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                <span class="material-symbols-outlined text-sm">open_in_new</span>
                <span>Voir le site public</span>
            </a>
            <a asp-controller="Admin" asp-action="Logout" class="flex items-center gap-2 px-4 py-2.5 rounded text-xs text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-colors font-bold">
                <span class="material-symbols-outlined text-sm">logout</span>
                <span>Déconnexion</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        
        <!-- Topbar Header -->
        <header class="bg-[#121419] border-b border-gold/20 px-6 py-4 flex items-center justify-between z-20">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-gold">admin_panel_settings</span>
                <span class="text-sm font-bold text-white uppercase tracking-wider">PANNEAU DE CONTRÔLE CLINIQUE</span>
            </div>
            
            <div class="flex items-center gap-4 text-xs">
                <div class="text-right hidden sm:block">
                    <span class="block font-bold text-white">Pr. Abdelfateh Slama</span>
                    <span class="block text-gold text-[10px]">Cabinet Medical • Sousse</span>
                </div>
                <img src="~/images/logo.png" alt="Avatar" class="w-9 h-9 rounded-full border border-gold/50 bg-white p-0.5 object-cover shadow" />
            </div>
        </header>

        <!-- Dynamic Body Content -->
        <main class="flex-1 p-6 md:p-10 overflow-y-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-lg bg-green-500/10 border border-green-500/30 text-green-400 text-xs font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-base">check_circle</span>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-base">error</span>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
