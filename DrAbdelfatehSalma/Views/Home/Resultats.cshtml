<!-- ============================================ -->
<!-- 1. HERO SECTION: DRAMATIC EDITORIAL SPLIT LAYOUT (100VH FULL SCREEN) -->
<!-- ============================================ -->
<section class="relative min-h-screen flex items-end md:items-center pt-20 pb-16 md:pb-0 overflow-hidden bg-surface-container-low border-b border-gold/20">
