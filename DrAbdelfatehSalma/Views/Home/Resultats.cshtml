        <div class="block md:hidden absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 z-10 pointer-events-none"></div>
        <img src="/images/chergievisage.jpg" alt="Bloc Opératoire & Salle d'Opération de Chirurgie Plastique Sousse" class="w-full h-full object-cover object-center transition-all duration-700 opacity-90 brightness-[1.02]" />
