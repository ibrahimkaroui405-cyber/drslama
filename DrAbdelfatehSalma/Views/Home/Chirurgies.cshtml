@section Scripts {
<script>
    function filterSurgeries(category) {
        // Update active tab buttons
        document.querySelectorAll('.surgery-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        // Filter cards smoothly
        const cards = document.querySelectorAll('.surgery-card');
        cards.forEach(card => {
            const cardCat = (card.dataset.category || '').toLowerCase();
            const targetCat = (category || '').toLowerCase();
            
            let match = false;
            if (targetCat === 'all') {
                match = true;
            } else if (targetCat === 'poitrine' || targetCat === 'sein' || targetCat === 'mammaire') {
                match = cardCat.includes('poitrine') || cardCat.includes('sein') || cardCat.includes('mammaire');
            } else if (targetCat === 'visage-cou' || targetCat === 'visage') {
                match = cardCat.includes('visage') || cardCat.includes('cou');
            } else if (targetCat === 'silhouette' || targetCat === 'corps') {
                match = cardCat.includes('silhouette') || cardCat.includes('corps');
            } else {
                match = cardCat === targetCat || cardCat.includes(targetCat) || targetCat.includes(cardCat);
            }

            if (match) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });

        // Smooth scroll focus down to grid when category card is clicked
        const grid = document.getElementById('surgeries-grid');
        if (grid && category !== 'all') {
            grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function switchMainTab(tab) {
        const btnOps = document.getElementById('tab-btn-operations');
        const btnRes = document.getElementById('tab-btn-results');
        const secOps = document.getElementById('section-operations');
        const secRes = document.getElementById('section-results');

        if (tab === 'operations') {
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secOps.classList.remove('hidden');
            secRes.classList.add('hidden');
        } else {
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secRes.classList.remove('hidden');
            secOps.classList.add('hidden');
            initMiniCardSliders();
        }
    }

    function filterResultsBranch(category) {
        document.querySelectorAll('.res-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('res-btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        document.querySelectorAll('.result-branch-card').forEach(card => {
            const cat = card.dataset.cat;
            if (category === 'all' || cat === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function initMiniCardSliders() {
        const sliders = document.querySelectorAll('.ba-card-slider');
        sliders.forEach(slider => {
            const beforeImg = slider.querySelector('.ba-card-before');
            const handle = slider.querySelector('.ba-card-handle');
            if (!beforeImg || !handle) return;

            let isDragging = false;

            function updatePosition(x) {
                const rect = slider.getBoundingClientRect();
                let offsetX = x - rect.left;
                if (offsetX < 0) offsetX = 0;
                if (offsetX > rect.width) offsetX = rect.width;
                const percentage = (offsetX / rect.width) * 100;
                
                beforeImg.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
                handle.style.left = `${percentage}%`;
            }

            slider.addEventListener('mousedown', (e) => {
                isDragging = true;
                updatePosition(e.clientX);
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging) updatePosition(e.clientX);
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            slider.addEventListener('touchstart', (e) => {
                isDragging = true;
                if (e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchend', () => { isDragging = false; });
        });
    }

    function unlockResultsGallery(e) {
        if (e) e.preventDefault();
        const input = document.getElementById('results-pass-input');
        const error = document.getElementById('results-pass-error');
        const rawVal = (input ? input.value : '').trim();
        const val = rawVal.toLowerCase();

        // Strong authorized medical passwords
        const validCodes = [
            'slama-vip-2026!',
            'afs-resultats-2026#',
            'clinique-slama-2026',
            'slama2026'
        ];

        if (validCodes.includes(val)) {
            if (error) error.classList.add('hidden');
            const gate = document.getElementById('results-password-gate');
            const content = document.getElementById('results-gallery-content');
            if (gate) gate.classList.add('hidden');
            if (content) content.classList.remove('hidden');
            setTimeout(() => { initMiniCardSliders(); }, 100);
        } else {
            if (error) {
                error.textContent = "❌ Code d'accès confidentiel incorrect. Veuillez saisir un code valide ou contacter le secrétariat.";
                error.classList.remove('hidden');
            }
        }
    }

    function lockResultsGallery() {
        const gate = document.getElementById('results-password-gate');
        const content = document.getElementById('results-gallery-content');
        if (gate) gate.classList.remove('hidden');
        if (content) content.classList.add('hidden');
    }

    // No session restore — password required on every page load
    function checkResultsUnlockStatus() {}

    document.addEventListener('DOMContentLoaded', () => {
        checkResultsUnlockStatus();
        initMiniCardSliders();
    });
</script>
}
