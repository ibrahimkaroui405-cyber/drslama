@section Scripts {
<script>
    function filterSurgeries(category) {
        // Update active tab buttons
        document.querySelectorAll('.surgery-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        // Filter cards smoothly
        const cards = document.querySelectorAll('.surgery-card');
        cards.forEach(card => {
            const cardCat = (card.dataset.category || '').toLowerCase();
            const targetCat = (category || '').toLowerCase();
            
            let match = false;
            if (targetCat === 'all') {
                match = true;
            } else if (targetCat === 'poitrine' || targetCat === 'sein' || targetCat === 'mammaire') {
                match = cardCat.includes('poitrine') || cardCat.includes('sein') || cardCat.includes('mammaire');
            } else if (targetCat === 'visage-cou' || targetCat === 'visage') {
                match = cardCat.includes('visage') || cardCat.includes('cou');
            } else if (targetCat === 'silhouette' || targetCat === 'corps') {
                match = cardCat.includes('silhouette') || cardCat.includes('corps');
            } else {
                match = cardCat === targetCat || cardCat.includes(targetCat) || targetCat.includes(cardCat);
            }

            if (match) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });

        // Smooth scroll focus down to grid when category card is clicked
        const grid = document.getElementById('surgeries-grid');
        if (grid && category !== 'all') {
            grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function switchMainTab(tab) {
        const btnOps = document.getElementById('tab-btn-operations');
        const btnRes = document.getElementById('tab-btn-results');
        const secOps = document.getElementById('section-operations');
        const secRes = document.getElementById('section-results');

        if (tab === 'operations') {
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secOps.classList.remove('hidden');
            secRes.classList.add('hidden');
        } else {
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secRes.classList.remove('hidden');
            secOps.classList.add('hidden');
            initMiniCardSliders();
        }
    }

    function filterResultsBranch(category) {
        document.querySelectorAll('.res-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('res-btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        document.querySelectorAll('.result-branch-card').forEach(card => {
            const cat = card.dataset.cat;
            if (category === 'all' || cat === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function initMiniCardSliders() {
        const sliders = document.querySelectorAll('.ba-card-slider');
        sliders.forEach(slider => {
            const beforeImg = slider.querySelector('.ba-card-before');
            const handle = slider.querySelector('.ba-card-handle');
            if (!beforeImg || !handle) return;

            let isDragging = false;

            function updatePosition(x) {
                const rect = slider.getBoundingClientRect();
                let offsetX = x - rect.left;
                if (offsetX < 0) offsetX = 0;
                if (offsetX > rect.width) offsetX = rect.width;
                const percentage = (offsetX / rect.width) * 100;
                
                beforeImg.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
                handle.style.left = `${percentage}%`;
            }

            slider.addEventListener('mousedown', (e) => {
                isDragging = true;
                updatePosition(e.clientX);
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging) updatePosition(e.clientX);
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            slider.addEventListener('touchstart', (e) => {
                isDragging = true;
                if (e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchend', () => { isDragging = false; });
        });
    }

    function unlockResultsGallery(e) {
        if (e) e.preventDefault();
        const input = document.getElementById('results-pass-input');
        const error = document.getElementById('results-pass-error');
        const rawVal = (input ? input.value : '').trim();
        const val = rawVal.toLowerCase();

        // Strong authorized medical passwords
        const validCodes = [
            'slama-vip-2026!',
            'afs-resultats-2026#',
            'clinique-slama-2026',
            'slama2026'
        ];

        if (validCodes.includes(val)) {
            if (error) error.classList.add('hidden');
            const gate = document.getElementById('results-password-gate');
            const content = document.getElementById('results-gallery-content');
            if (gate) gate.classList.add('hidden');
            if (content) content.classList.remove('hidden');
            setTimeout(() => { initMiniCardSliders(); }, 100);
        } else {
            if (error) {
                error.textContent = "❌ Code d'accès confidentiel incorrect. Veuillez saisir un code valide ou contacter le secrétariat.";
                error.classList.remove('hidden');
            }
        }
    }

    function lockResultsGallery() {
        const gate = document.getElementById('results-password-gate');
        const content = document.getElementById('results-gallery-content');
        if (gate) gate.classList.remove('hidden');
        if (content) content.classList.add('hidden');
    }

    // No session restore — password required on every page load
    function checkResultsUnlockStatus() {}

    // ============================================
    // LIGHTBOX CASE MODAL CONTROLLER
    // ============================================
    const resultsPageData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resultatsList.Select((r, i) => new {
        id = i,
        key = "case-" + r.Id,
        category = string.IsNullOrEmpty(r.CategoryTitle) ? "CHIRURGIE" : r.CategoryTitle.ToUpper(),
        title = r.Title,
        desc = r.Description ?? "",
        beforeImg = r.BeforeImageUrl,
        afterImg = r.AfterImageUrl,
        spec = "Dr. Abdelfateh Slama",
        tag1 = string.IsNullOrEmpty(r.CategoryTitle) ? "Chirurgie Esthétique" : r.CategoryTitle
    })));

    let currentResultsPageModalIndex = 0;

    function openCaseModal(param) {
        let index = 0;
        if (typeof param === 'number') {
            index = param;
        } else if (typeof param === 'string') {
            const foundIdx = resultsPageData.findIndex(item => item.key === param);
            if (foundIdx !== -1) index = foundIdx;
        }

        currentResultsPageModalIndex = index;
        const data = resultsPageData[index];
        if (!data) return;

        const catEl = document.getElementById('modal-category');
        if (catEl) catEl.innerText = data.category;
        const titleEl = document.getElementById('modal-title');
        if (titleEl) titleEl.innerText = data.title;
        const descEl = document.getElementById('modal-desc');
        if (descEl) descEl.innerText = data.desc;
        const tag1El = document.getElementById('modal-tag1');
        if (tag1El) tag1El.innerText = data.tag1;

        const beforeImg = document.getElementById('modal-img-before');
        const afterImg = document.getElementById('modal-img-after');
        const handle = document.getElementById('modal-ba-handle');
        const sideBefore = document.getElementById('modal-side-img-before');
        const sideAfter = document.getElementById('modal-side-img-after');

        if (beforeImg && afterImg) {
            beforeImg.src = data.beforeImg;
            afterImg.src = data.afterImg;
        }

        if (sideBefore && sideAfter) {
            sideBefore.src = data.beforeImg;
            sideAfter.src = data.afterImg;
        }

        setModalViewMode('slider');

        const modal = document.getElementById('case-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }
    }

    function setModalViewMode(mode) {
        const slider = document.getElementById('modal-ba-slider');
        const sideWrapper = document.getElementById('modal-side-wrapper');
        const beforeImg = document.getElementById('modal-img-before');
        const afterImg = document.getElementById('modal-img-after');
        const handle = document.getElementById('modal-ba-handle');
        const badgeBefore = document.getElementById('badge-before');
        const badgeAfter = document.getElementById('badge-after');
        const hints = document.getElementById('modal-slider-hints');

        const btnSlider = document.getElementById('btn-mode-slider');
        const btnAfter = document.getElementById('btn-mode-after');
        const btnBefore = document.getElementById('btn-mode-before');
        const btnSide = document.getElementById('btn-mode-side');

        const normalBtn = "px-3 py-1.5 rounded text-[10px] font-label-caps font-bold bg-white/10 hover:bg-white/20 text-white/80 hover:text-white transition-all";
        const activeBtn = "px-3 py-1.5 rounded text-[10px] font-label-caps font-bold gold-gradient text-white shadow transition-all";

        [btnSlider, btnAfter, btnBefore, btnSide].forEach(b => { if (b) b.className = normalBtn; });

        if (mode === 'slider') {
            if (btnSlider) btnSlider.className = activeBtn;
            if (slider) slider.classList.remove('hidden');
            if (sideWrapper) { sideWrapper.classList.add('hidden'); sideWrapper.classList.remove('flex'); }
            if (beforeImg) { beforeImg.style.clipPath = 'inset(0 50% 0 0)'; }
            if (handle) { handle.style.display = 'flex'; handle.style.left = '50%'; }
            if (badgeBefore) badgeBefore.style.display = 'block';
            if (badgeAfter) badgeAfter.style.display = 'block';
            if (hints) {
                hints.innerHTML = '<span>◄ Glisser vers la gauche (AVANT)</span><span class="text-gold font-bold">Image 100% Intégrale (Non Rognée)</span><span>Glisser vers la droite (APRÈS) ►</span>';
            }
        } else if (mode === 'after') {
            if (btnAfter) btnAfter.className = activeBtn;
            if (slider) slider.classList.remove('hidden');
            if (sideWrapper) { sideWrapper.classList.add('hidden'); sideWrapper.classList.remove('flex'); }
            if (beforeImg) beforeImg.style.clipPath = 'inset(0 100% 0 0)';
            if (handle) handle.style.display = 'none';
            if (badgeBefore) badgeBefore.style.display = 'none';
            if (badgeAfter) badgeAfter.style.display = 'block';
            if (hints) {
                hints.innerHTML = '<span></span><span class="text-gold font-bold">Vue Complète : Photo APRÈS (100% Entière)</span><span></span>';
            }
        } else if (mode === 'before') {
            if (btnBefore) btnBefore.className = activeBtn;
            if (slider) slider.classList.remove('hidden');
            if (sideWrapper) { sideWrapper.classList.add('hidden'); sideWrapper.classList.remove('flex'); }
            if (beforeImg) beforeImg.style.clipPath = 'inset(0 0 0 0)';
            if (handle) handle.style.display = 'none';
            if (badgeBefore) badgeBefore.style.display = 'block';
            if (badgeAfter) badgeAfter.style.display = 'none';
            if (hints) {
                hints.innerHTML = '<span></span><span class="text-gold font-bold">Vue Complète : Photo AVANT (100% Entière)</span><span></span>';
            }
        } else if (mode === 'side') {
            if (btnSide) btnSide.className = activeBtn;
            if (slider) slider.classList.add('hidden');
            if (sideWrapper) { sideWrapper.classList.remove('hidden'); sideWrapper.classList.add('flex'); }
            if (hints) {
                hints.innerHTML = '<span>Photo AVANT (Gauche)</span><span class="text-gold font-bold">Comparaison Côte à Côte (Non Rognées)</span><span>Photo APRÈS (Droite)</span>';
            }
        }
    }

    function closeCaseModal() {
        const modal = document.getElementById('case-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function navigateResultsPageModal(direction) {
        if (!resultsPageData || resultsPageData.length === 0) return;
        let newIndex = currentResultsPageModalIndex + direction;
        if (newIndex < 0) newIndex = resultsPageData.length - 1;
        if (newIndex >= resultsPageData.length) newIndex = 0;
        openCaseModal(newIndex);
    }

    function initModalSlider() {
        const slider = document.getElementById('modal-ba-slider');
        const beforeImg = document.getElementById('modal-img-before');
        const handle = document.getElementById('modal-ba-handle');
        let isDragging = false;

        if (!slider || !beforeImg || !handle) return;

        function setModalPos(clientX) {
            const rect = slider.getBoundingClientRect();
            let x = clientX - rect.left;
            if (x < 0) x = 0;
            if (x > rect.width) x = rect.width;
            const pct = (x / rect.width) * 100;
            beforeImg.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
            handle.style.left = pct + '%';
        }

        slider.addEventListener('mousedown', (e) => {
            isDragging = true;
            setModalPos(e.clientX);
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            setModalPos(e.clientX);
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        slider.addEventListener('touchstart', (e) => {
            isDragging = true;
            if (e.touches && e.touches[0]) setModalPos(e.touches[0].clientX);
        });

        window.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            if (e.touches && e.touches[0]) setModalPos(e.touches[0].clientX);
        });

        window.addEventListener('touchend', () => {
            isDragging = false;
        });
    }

    window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('case-modal');
        if (!modal || modal.classList.contains('hidden')) return;

        if (e.key === 'Escape') {
            closeCaseModal();
        } else if (e.key === 'ArrowLeft') {
            navigateResultsPageModal(-1);
        } else if (e.key === 'ArrowRight') {
            navigateResultsPageModal(1);
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        checkResultsUnlockStatus();
        initMiniCardSliders();
        initModalSlider();
    });
</script>
}
