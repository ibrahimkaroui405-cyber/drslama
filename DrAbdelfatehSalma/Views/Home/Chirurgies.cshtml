        </div>

        <!-- Success State Container -->
        <div id="request-code-success-container" class="hidden p-8 text-center space-y-5 overflow-y-auto flex-1">
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center shadow-inner">
                <span class="material-symbols-outlined text-3xl">check_circle</span>
            </div>
            <div class="space-y-2">
                <h4 class="font-display-lg text-2xl font-bold text-primary">Demande Transmise au Docteur</h4>
                <p class="font-body-md text-xs text-primary/80 leading-relaxed max-w-md mx-auto">
                    Votre formulaire complet a bien été enregistré et transmis au Pr. Abdelfateh Slama. Le docteur consultera vos informations et vous enverra personnellement votre code d'accès confidentiel sur votre WhatsApp :
                </p>
                <div class="inline-block px-5 py-2.5 bg-emerald-50 border border-emerald-300 rounded-full text-emerald-900 font-bold font-mono text-sm tracking-wide">
                    <span id="req-success-phone">+216 ...</span>
                </div>
            </div>

            <div class="space-y-3 pt-3 max-w-md mx-auto">
                <a id="req-wa-direct-link" href="#" target="_blank" class="w-full py-3.5 px-6 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-label-caps text-xs font-bold tracking-widest shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-base">chat</span>
                    <span>ENVOYER LE MESSAGE DIRECT SUR WHATSAPP</span>
                </a>
                <button type="button" onclick="closeRequestCodeModal()" class="w-full py-3 px-6 rounded-full bg-neutral-100 hover:bg-neutral-200 text-primary font-label-caps text-[11px] font-bold tracking-wider transition-colors cursor-pointer">
                    COMPRIS, FERMER
                </button>
            </div>
        </div>

    </div>
</div>

    </div>
</div>

@section Scripts {
<script>
    function filterSurgeries(category) {
        // Update active tab buttons
        document.querySelectorAll('.surgery-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        // Filter cards smoothly
        const cards = document.querySelectorAll('.surgery-card');
        cards.forEach(card => {
            const cardCat = (card.dataset.category || '').toLowerCase();
            const targetCat = (category || '').toLowerCase();
            
            let match = false;
            if (targetCat === 'all') {
                match = true;
            } else if (targetCat === 'poitrine' || targetCat === 'sein' || targetCat === 'mammaire') {
                match = cardCat.includes('poitrine') || cardCat.includes('sein') || cardCat.includes('mammaire');
            } else if (targetCat === 'visage-cou' || targetCat === 'visage') {
                match = cardCat.includes('visage') || cardCat.includes('cou');
            } else if (targetCat === 'silhouette' || targetCat === 'corps') {
                match = cardCat.includes('silhouette') || cardCat.includes('corps');
            } else {
                match = cardCat === targetCat || cardCat.includes(targetCat) || targetCat.includes(cardCat);
            }

            if (match) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });

        // Smooth scroll focus down to grid when category card is clicked
        const grid = document.getElementById('surgeries-grid');
        if (grid && category !== 'all') {
            grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function switchMainTab(tab) {
        const btnOps = document.getElementById('tab-btn-operations');
        const btnRes = document.getElementById('tab-btn-results');
        const secOps = document.getElementById('section-operations');
        const secRes = document.getElementById('section-results');

        if (tab === 'operations') {
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secOps.classList.remove('hidden');
            secRes.classList.add('hidden');
        } else {
            btnRes.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnOps.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            secRes.classList.remove('hidden');
            secOps.classList.add('hidden');
            initMiniCardSliders();
        }
    }

    function filterResultsBranch(category) {
        document.querySelectorAll('.res-tab').forEach(btn => {
            btn.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            btn.classList.add('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
        });
        const activeBtn = document.getElementById('res-btn-' + category);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'text-primary', 'border-gold/30', 'shadow-sm');
            activeBtn.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        document.querySelectorAll('.result-branch-card').forEach(card => {
            const cat = card.dataset.cat;
            if (category === 'all' || cat === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function initMiniCardSliders() {
        const sliders = document.querySelectorAll('.ba-card-slider');
        sliders.forEach(slider => {
            const beforeImg = slider.querySelector('.ba-card-before');
            const handle = slider.querySelector('.ba-card-handle');
            if (!beforeImg || !handle) return;

            let isDragging = false;

            function updatePosition(x) {
                const rect = slider.getBoundingClientRect();
                let offsetX = x - rect.left;
                if (offsetX < 0) offsetX = 0;
                if (offsetX > rect.width) offsetX = rect.width;
                const percentage = (offsetX / rect.width) * 100;
                
                beforeImg.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
                handle.style.left = `${percentage}%`;
            }

            slider.addEventListener('mousedown', (e) => {
                isDragging = true;
                updatePosition(e.clientX);
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging) updatePosition(e.clientX);
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            slider.addEventListener('touchstart', (e) => {
                isDragging = true;
                if (e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length > 0) updatePosition(e.touches[0].clientX);
            });

            window.addEventListener('touchend', () => { isDragging = false; });
        });
    }

    function setCardView(idx, mode) {
        const viewSide = document.getElementById('view-side-' + idx);
        const viewBefore = document.getElementById('view-before-' + idx);
        const viewAfter = document.getElementById('view-after-' + idx);

        const btnSide = document.getElementById('btn-side-' + idx);
        const btnBefore = document.getElementById('btn-before-' + idx);
        const btnAfter = document.getElementById('btn-after-' + idx);

        const activeCls = 'px-2 py-0.5 rounded text-[8px] font-label-caps font-bold gold-gradient text-white shadow';
        const inactiveCls = 'px-2 py-0.5 rounded text-[8px] font-label-caps font-bold text-white/70 hover:text-white';

        if (btnSide) btnSide.className = inactiveCls;
        if (btnBefore) btnBefore.className = inactiveCls;
        if (btnAfter) btnAfter.className = inactiveCls;

        if (viewSide) viewSide.classList.add('hidden');
        if (viewBefore) viewBefore.classList.add('hidden');
        if (viewAfter) viewAfter.classList.add('hidden');

        if (mode === 'side') {
            if (viewSide) viewSide.classList.remove('hidden');
            if (btnSide) btnSide.className = activeCls;
        } else if (mode === 'before') {
            if (viewBefore) viewBefore.classList.remove('hidden');
            if (btnBefore) btnBefore.className = activeCls;
        } else if (mode === 'after') {
            if (viewAfter) viewAfter.classList.remove('hidden');
            if (btnAfter) btnAfter.className = activeCls;
        }
    }

    async function unlockResultsGallery(e) {
        if (e) e.preventDefault();
        const input = document.getElementById('results-pass-input');
        const error = document.getElementById('results-pass-error');
        const submitBtn = e && e.target ? e.target.querySelector('button[type="submit"]') : null;
        const rawVal = (input ? input.value : '').trim();
        if (!rawVal) return;

        if (submitBtn) submitBtn.disabled = true;

        let ok = false;
        try {
            // Code is verified on the server (managed by the doctor in Admin > Code Galerie)
            const body = new FormData();
            body.append('code', rawVal);
            const res = await fetch('/Home/VerifyGalleryCode', { method: 'POST', body });
            const data = await res.json();
            ok = !!(data && data.success);
        } catch (ex) {
            console.error('Gallery code verification failed:', ex);
        }

        if (submitBtn) submitBtn.disabled = false;

        if (ok) {
            if (error) error.classList.add('hidden');
            const gate = document.getElementById('results-password-gate');
            const content = document.getElementById('results-gallery-content');
            if (gate) gate.classList.add('hidden');
            if (content) content.classList.remove('hidden');
        } else {
            if (error) {
                error.textContent = "❌ Code d'accès confidentiel incorrect. Veuillez saisir un code valide ou contacter le secrétariat.";
                error.classList.remove('hidden');
            }
        }
    }

    function lockResultsGallery() {
        const gate = document.getElementById('results-password-gate');
        const content = document.getElementById('results-gallery-content');
        if (gate) gate.classList.remove('hidden');
        if (content) content.classList.add('hidden');
    }

    // No session restore — password required on every page load
    function checkResultsUnlockStatus() {}

    // ============================================
    // LIGHTBOX CASE MODAL CONTROLLER
    // ============================================
    const resultsPageData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resultatsList.Select((r, i) => new {
        id = i,
        key = "case-" + r.Id,
        category = string.IsNullOrEmpty(r.CategoryTitle) ? "CHIRURGIE" : r.CategoryTitle.ToUpper(),
        title = r.Title,
        desc = r.Description ?? "",
        beforeImg = r.BeforeImageUrl,
        afterImg = r.AfterImageUrl,
        spec = "Dr. Abdelfateh Slama",
        tag1 = string.IsNullOrEmpty(r.CategoryTitle) ? "Chirurgie Esthétique" : r.CategoryTitle
    })));

    let currentResultsPageModalIndex = 0;

    function openCaseModal(param) {
        let index = 0;
        if (typeof param === 'number') {
            index = param;
        } else if (typeof param === 'string') {
            const foundIdx = resultsPageData.findIndex(item => item.key === param);
            if (foundIdx !== -1) index = foundIdx;
        }

        currentResultsPageModalIndex = index;
        const data = resultsPageData[index];
        if (!data) return;

        const catEl = document.getElementById('modal-category');
        if (catEl) catEl.innerText = data.category;
        const titleEl = document.getElementById('modal-title');
        if (titleEl) titleEl.innerText = data.title;
        const descEl = document.getElementById('modal-desc');
        if (descEl) descEl.innerText = data.desc || '';

        const beforeImg = document.getElementById('modal-img-before');
        const afterImg = document.getElementById('modal-img-after');

        if (beforeImg) beforeImg.src = data.beforeImg;
        if (afterImg) afterImg.src = data.afterImg;

        const modal = document.getElementById('case-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }
    }

    function closeCaseModal() {
        const modal = document.getElementById('case-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function navigateResultsPageModal(direction) {
        if (!resultsPageData || resultsPageData.length === 0) return;
        let newIndex = currentResultsPageModalIndex + direction;
        if (newIndex < 0) newIndex = resultsPageData.length - 1;
        if (newIndex >= resultsPageData.length) newIndex = 0;
        openCaseModal(newIndex);
    }

    // ============================================
    // REQUEST CODE FORM CONTROLLER (WHATSAPP VERIFICATION)
    // ============================================
    function openRequestCodeModal() {
        const modal = document.getElementById('request-code-modal');
        const formBox = document.getElementById('request-code-form-container');
        const successBox = document.getElementById('request-code-success-container');
        const err = document.getElementById('req-code-error');
        if (formBox) formBox.classList.remove('hidden');
        if (successBox) successBox.classList.add('hidden');
        if (err) err.classList.add('hidden');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
            setTimeout(() => {
                const nameInput = document.getElementById('req-code-name');
                if (nameInput) nameInput.focus();
            }, 100);
        }
    }

    function closeRequestCodeModal() {
        const modal = document.getElementById('request-code-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function closeRequestCodeModalAndFocusInput() {
        closeRequestCodeModal();
        const passInput = document.getElementById('results-pass-input');
        if (passInput) {
            passInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => passInput.focus(), 300);
        }
    }

    async function submitRequestCodeForm(e) {
        e.preventDefault();
        const nom = (document.getElementById('req-code-nom')?.value || '').trim();
        const prenom = (document.getElementById('req-code-prenom')?.value || '').trim();
        const indicatif = document.getElementById('req-code-indicatif')?.value || '+216';
        const phone = (document.getElementById('req-code-phone')?.value || '').trim();
        const email = (document.getElementById('req-code-email')?.value || '').trim();
        const consultationType = document.getElementById('req-code-procedure')?.value || 'Demande de Code Secret';
        const message = (document.getElementById('req-code-message')?.value || '').trim();
        const consent = document.getElementById('req-code-consent')?.checked;
        const fileInput = document.getElementById('req-code-file');
        const btn = document.getElementById('req-code-submit-btn');
        const err = document.getElementById('req-code-error');

        if (!nom || !prenom || !phone || !email || !message) {
            if (err) {
                err.textContent = "Veuillez remplir tous les champs obligatoires (*).";
                err.classList.remove('hidden');
            }
            return;
        }

        if (!consent) {
            if (err) {
                err.textContent = "Veuillez accepter l'utilisation des informations pour répondre à votre demande.";
                err.classList.remove('hidden');
            }
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">refresh</span><span>ENVOI EN COURS...</span>';
        }

        const formData = new FormData();
        formData.append('Nom', nom);
        formData.append('Prenom', prenom);
        formData.append('Indicatif', indicatif);
        formData.append('Phone', phone);
        formData.append('Email', email);
        formData.append('ConsultationType', consultationType);
        formData.append('Message', message);
        formData.append('ConsentAccepted', 'true');
        formData.append('Objet', 'Demande de Code Secret Galerie Avant/Après');
        if (fileInput && fileInput.files && fileInput.files[0]) {
            formData.append('photoFile', fileInput.files[0]);
        }

        // Save lead in database via HomeController (received in Admin under Demandes de RDV)
        try {
            await fetch('/Home/DemandeCodeGalerie', {
                method: 'POST',
                body: formData
            });
        } catch (ex) {
            console.error('Error saving lead:', ex);
        }

        const fullPhone = phone.startsWith('+') ? phone : `${indicatif} ${phone}`.trim();
        const fullName = `${prenom} ${nom}`.trim();

        // Pre-fill personalized WhatsApp verification message to the clinic (+216 25 196 777)
        const msgText = `Bonjour Pr. Slama,\n\nJe m'appelle ${fullName} (Tél/WhatsApp: ${fullPhone}, Email: ${email}).\nJ'ai soumis le formulaire pour : "${consultationType}".\n\nMon message : "${message}"\n\nMerci de bien vouloir me communiquer le code confidentiel pour consulter la galerie Avant / Après.`;
        const waUrl = `https://wa.me/21625196777?text=${encodeURIComponent(msgText)}`;

        // Switch to success view inside the modal
        const formBox = document.getElementById('request-code-form-container');
        const successBox = document.getElementById('request-code-success-container');
        const phoneConfirm = document.getElementById('req-success-phone');
        const directLink = document.getElementById('req-wa-direct-link');

        if (phoneConfirm) phoneConfirm.textContent = fullPhone;
        if (directLink) directLink.href = waUrl;

        if (formBox) formBox.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');

        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-base">send</span><span>TRANSMETTRE MA DEMANDE AU DOCTEUR</span>';
        }

        // Open WhatsApp directly in new tab
        window.open(waUrl, '_blank');
    }

    window.addEventListener('keydown', (e) => {
        const caseModal = document.getElementById('case-modal');
        const reqModal = document.getElementById('request-code-modal');

        if (e.key === 'Escape') {
            if (reqModal && !reqModal.classList.contains('hidden')) {
                closeRequestCodeModal();
            } else if (caseModal && !caseModal.classList.contains('hidden')) {
                closeCaseModal();
            }
        } else if (e.key === 'ArrowLeft') {
            if (caseModal && !caseModal.classList.contains('hidden')) {
                navigateResultsPageModal(-1);
            }
        } else if (e.key === 'ArrowRight') {
            if (caseModal && !caseModal.classList.contains('hidden')) {
                navigateResultsPageModal(1);
            }
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        checkResultsUnlockStatus();
    });
</script>
}
