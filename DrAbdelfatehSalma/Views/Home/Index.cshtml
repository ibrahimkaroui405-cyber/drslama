@section Scripts {
<style>
    /* Results gallery blur state */
    .results-blurable {
        filter: blur(12px) brightness(0.7);
        transition: filter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .results-unlocked .results-blurable {
        filter: none;
    }
    /* Lock overlay */
    .results-lock-overlay {
        background: rgba(0,0,0,0.35);
        backdrop-filter: blur(2px);
        transition: opacity 0.4s ease;
    }
    .results-unlocked .results-lock-overlay {
        opacity: 0;
        pointer-events: none;
    }
</style>
<script>
    // ==========================================
    // RESULTS GALLERY PASSWORD PROTECTION
    // ==========================================
    // Same authorized codes as Chirurgies & Esthetique results gallery
    const RESULTS_VALID_CODES = [
        'slama-vip-2026!',
        'afs-resultats-2026#',
        'clinique-slama-2026',
        'slama2026'
    ];
    let _resultsUnlocked = false; // resets on every page reload

    function isResultsUnlocked() {
        return _resultsUnlocked;
    }

    function applyResultsBlurState() {
        const track = document.getElementById('gallery-carousel-track');
        if (!track) return;
        if (_resultsUnlocked) {
            track.classList.add('results-unlocked');
        } else {
            track.classList.remove('results-unlocked');
        }
    }

    function openResultsPasswordModal() {
        if (isResultsUnlocked()) return;
        const modal = document.getElementById('results-password-modal');
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        const input = document.getElementById('results-password-input');
        if (input) { input.value = ''; setTimeout(() => input.focus(), 80); }
        const err = document.getElementById('results-password-error');
        if (err) err.classList.add('hidden');
    }

    function closeResultsPasswordModal() {
        const modal = document.getElementById('results-password-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    function submitResultsPassword() {
        const input = document.getElementById('results-password-input');
        const err = document.getElementById('results-password-error');
        if (!input) return;
        if (RESULTS_VALID_CODES.includes(input.value.trim().toLowerCase())) {
            _resultsUnlocked = true;
            applyResultsBlurState();
            closeResultsPasswordModal();
        } else {
            if (err) err.classList.remove('hidden');
            input.value = '';
            input.focus();
            input.classList.add('border-red-400');
            setTimeout(() => input.classList.remove('border-red-400'), 800);
        }
    }

    function toggleResultsPwdVisibility() {
        const input = document.getElementById('results-password-input');
        const icon = document.getElementById('results-eye-icon');
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            if (icon) icon.textContent = 'visibility';
        }
    }

    // ==========================================
    // --- Galerie de Résultats Side Navigation Arrows & Drag Carousel Slider ---
    let isMouseDown = false;
    let startX = 0;
    let scrollLeftStart = 0;

    function initGalleryCarousel() {
        const track = document.getElementById('gallery-carousel-track');
        if (!track) return;

        // Mouse Dragging (Desktop)
        track.addEventListener('mousedown', (e) => {
            isMouseDown = true;
            startX = e.pageX - track.offsetLeft;
            scrollLeftStart = track.scrollLeft;
        });

        track.addEventListener('mouseleave', () => {
            isMouseDown = false;
        });

        track.addEventListener('mouseup', () => {
            isMouseDown = false;
        });

        track.addEventListener('mousemove', (e) => {
            if (!isMouseDown) return;
            e.preventDefault();
            const x = e.pageX - track.offsetLeft;
            const walk = (x - startX) * 1.5;
            track.scrollLeft = scrollLeftStart - walk;
        });
    }

    function manualScrollGallery(direction) {
        const track = document.getElementById('gallery-carousel-track');
        if (!track) return;

        const scrollAmount = 340;
        if (direction === 'left') {
            track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
            track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
    }

    // Toggle Card Photo between Avant & Après cleanly
    function toggleCardPhoto(id) {
        const img = document.getElementById(`card-img-${id}`);
        const btnText = document.getElementById(`card-btn-text-${id}`);
        if (!img || !btnText) return;

        const afterSrc = img.dataset.after;
        const beforeSrc = img.dataset.before;

        if (btnText.textContent.includes('AVANT')) {
            img.src = beforeSrc;
            btnText.textContent = 'VOIR APRÈS';
        } else {
            img.src = afterSrc;
            btnText.textContent = 'VOIR AVANT';
        }
    }

    // Category Filtering for Results Gallery
    function filterResults(category) {
        const cards = document.querySelectorAll('#gallery-carousel-track .result-card');
        const tabs = document.querySelectorAll('.gallery-tab');
        
        tabs.forEach(tab => {
            tab.classList.remove('bg-primary', 'text-white');
            tab.classList.add('bg-white', 'text-primary');
        });
        
        event.currentTarget.classList.remove('bg-white', 'text-primary');
        event.currentTarget.classList.add('bg-primary', 'text-white');

        cards.forEach(card => {
            if (category === 'all' || card.dataset.category === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
        
        const track = document.getElementById('gallery-carousel-track');
        if (track) track.scrollTo({ left: 0, behavior: 'smooth' });
    }

    // Filter Testimonials (All / Video / Text)
    function filterTestimonials(type) {
        const cards = document.querySelectorAll('.testimonial-card');
        const tabs = document.querySelectorAll('.testimonial-tab');

        tabs.forEach(tab => {
            tab.classList.remove('bg-white', 'text-black');
            tab.classList.add('bg-transparent', 'text-white');
        });

        event.currentTarget.classList.remove('bg-transparent', 'text-white');
        event.currentTarget.classList.add('bg-white', 'text-black');

        cards.forEach(card => {
            if (type === 'all' || card.dataset.type === type) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

