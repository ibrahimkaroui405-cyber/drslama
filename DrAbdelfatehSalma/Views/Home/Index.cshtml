@{
    Layout = "_Layout";
    ViewData["Title"] = "Accueil";
}

<!-- BEGIN: HeroSection -->
<section class="relative min-h-screen lg:h-screen flex items-center pt-20 md:pt-24 pb-12 overflow-hidden bg-ivory">
    <!-- Right-aligned Continuous Hero Video (Full-bleed on mobile, 50% width on desktop) -->
    <div class="absolute inset-0 md:left-auto md:right-0 md:top-0 w-full md:w-1/2 h-full z-0 overflow-hidden">
        <!-- Seamless Full-Bleed Gradient (No boxes: allows full-screen video visibility while keeping text 100% clear) -->
        <div class="absolute inset-0 bg-gradient-to-r from-ivory/90 via-ivory/65 to-ivory/30 md:from-ivory md:via-ivory/70 md:to-transparent z-10 pointer-events-none"></div>

        <!-- Video Background Container -->
        <div class="relative w-full h-full">
            <video id="hero-main-video" autoplay loop muted playsinline webkit-playsinline preload="auto" poster="/images/dr_slama_operating_suite.png" class="w-full h-full object-cover opacity-90 md:opacity-100 transition-opacity duration-500">
                <source src="/videos/homeslidevideo.mp4" type="video/mp4"/>
            </video>
        </div>
    </div>
    
    <div class="relative z-30 w-full px-6 md:px-margin-desktop max-w-container-max mx-auto flex items-center my-auto">
        <div class="w-full md:w-7/12 lg:w-6/12 space-y-5 my-auto">

            <!-- Big Signature Doctor Name -->
            <h1 class="font-display-lg text-4xl sm:text-6xl md:text-[75px] lg:text-[85px] leading-[0.9] text-[#7f5518] tracking-tight font-black">
                Dr Abdelfateh<br/>
                <span class="font-semibold italic text-black tracking-normal">SLAMA</span>
            </h1>

            <!-- Medical Title & Sub-Specialties -->
            <div class="space-y-1">
                <h2 class="font-display-lg text-2xl sm:text-3xl text-gold font-bold">
                    Professeur et Chef de Service
                </h2>
                <p class="font-label-caps text-xs sm:text-sm font-bold tracking-[0.14em] text-slate-800 uppercase">
                    CHIRURGIE ESTHÉTIQUE — CHIRURGIE DE LA FACE
                </p>
            </div>

            <!-- Quote Box with Gold Left Border -->
            <div class="border-l-2 border-gold pl-4 sm:pl-5 py-1 max-w-xl">
                <p class="font-body-md text-xs sm:text-sm text-primary/80 italic leading-relaxed">
                    "L'excellence chirurgicale au service de l'harmonie naturelle. Une expertise médicale universitaire et un accompagnement sur-mesure."
                </p>
                <span class="font-label-caps text-[9px] sm:text-[9.5px] font-bold text-gold tracking-widest uppercase block mt-2">
                    ANCIEN INTERNE DES HÔPITAUX DE FRANCE • LILLE
                </span>
            </div>

            <!-- Dual Action Pill Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center pt-2">
                <a asp-controller="Home" asp-action="Contact" class="bg-gold hover:bg-gold-dark text-white px-8 py-4 rounded-full font-label-caps text-[11px] tracking-widest font-bold shadow-md hover:shadow-lg transition-all text-center flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-base">mail</span>
                    NOUS CONTACTER
                </a>
                <a asp-controller="Home" asp-action="Chirurgies" class="bg-white hover:bg-slate-50 border border-slate-300 text-primary px-8 py-4 rounded-full font-label-caps text-[11px] tracking-widest font-bold shadow-xs hover:shadow-sm transition-all text-center flex items-center justify-center gap-2">
                    NOS INTERVENTIONS →
                </a>
            </div>

            <!-- Bottom Meta Footprint -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-primary/70 font-body-md text-xs pt-3">
                <span class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                    Cabinet Médical &amp; Clinique • Sousse, Tunisie
                </span>
            </div>

        </div>
    </div>

    <!-- Elegant Vertical Detail -->
    <div class="absolute bottom-12 right-12 hidden md:flex flex-col items-center gap-8 z-20">
        <span class="font-label-caps text-[9px] tracking-[0.5em] uppercase text-primary/60 rotate-180 drop-shadow-sm" style="writing-mode: vertical-rl;">SCROLL</span>
        <div class="h-24 w-[1px] bg-primary/30 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-full bg-primary animate-scroll-line"></div>
        </div>
    </div>
</section>
<!-- END: HeroSection -->

<!-- BEGIN: LePraticien (Two Contrasting Sections Layout) -->
<section class="relative z-30 py-16 md:py-24 bg-white border-b border-gold/20" id="about">
    <div class="max-w-container-max mx-auto px-6 md:px-margin-desktop space-y-12 md:space-y-16">
        
        <!-- SECTION 1: MINIMALIST MAGAZINE SPLIT (Photo Left, Serif Quote Right) -->
        <div class="bg-white rounded-3xl border border-gold/20 p-6 md:p-8 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                
                <!-- Left Side: Doctor Portrait Showcase (5 Cols, balanced medium size) -->
                <div class="lg:col-span-5 max-w-[420px] mx-auto w-full relative group">
                    <div class="aspect-[4/5] max-h-[460px] w-full rounded-2xl overflow-hidden border border-gold/35 shadow-md bg-slate-50 relative">
                        <img alt="Pr. Abdelfateh Slama" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700" src="/images/drpic.jpg"/>
                    </div>
                    
                    <!-- Floating Caption Badge -->
                    <div class="absolute -bottom-3 left-4 bg-white border border-gold/30 px-3.5 py-1.5 rounded-lg shadow-md flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-gold"></span>
                        <span class="font-label-caps text-[9px] text-primary font-bold tracking-wider uppercase">PR. ABDELFATEH SLAMA</span>
                    </div>
                </div>

                <!-- Right Side: Large Serif Quote & Narrative (7 Cols) -->
                <div class="lg:col-span-7 space-y-4">
                    <div class="inline-flex items-center gap-2 text-gold font-label-caps text-[11px] font-bold tracking-[0.2em] uppercase">
                        <span class="w-2 h-2 rounded-full bg-gold"></span>
                        LA VISION ESTHÉTIQUE &amp; PHILOSOPHIE
                    </div>

                    <!-- Main Statement Quote -->
                    <h2 class="font-display-lg text-lg sm:text-xl md:text-2xl font-bold text-primary italic leading-snug border-l-3 border-gold pl-4">
                        "Le visage et le corps sont considérés comme une œuvre d’art globale. L’objectif de la chirurgie esthétique est de retrouver la meilleure version de soi même avec un équilibre et une confiance chaque matin devant le miroir."
                    </h2>

                    <!-- Medical Expertise Text -->
                    <p class="font-body-md text-primary/80 text-sm leading-relaxed">
                        Le Pr SLAMA vous propose une expertise médicale en chirurgie réparatrice et esthétique allant du diagnostic précis des anomalies jusqu’à la chirurgie avec ses indications, ses techniques et ses résultats.
                    </p>

                    <!-- Highlight Quote Box: First Consultation Commitment -->
                    <div class="p-4 rounded-xl bg-ivory border border-gold/30 shadow-xs space-y-1">
                        <span class="font-label-caps text-gold text-[9px] font-bold tracking-wider uppercase block">
                            ✦ L'OBJECTIF DE LA 1ÈRE CONSULTATION
                        </span>
                        <p class="font-body-md text-xs sm:text-sm text-primary/90 italic leading-relaxed">
                            "Lors de la 1ère consultation, notre objectif principal est de définir votre demande et comprendre votre attente, afin de choisir une solution personnalisée qui donne le meilleur résultat."
                        </p>
                    </div>
                </div>

            </div>
        </div>

        <!-- SECTION 2: MODERN ASYMMETRIC BENTO GRID -->
        <div class="space-y-4 relative">
            
            <!-- TOP BENTO ROW: Main Bio (7 Cols) + Portrait Spotlight (5 Cols) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
                
                <!-- Bento Tile A: Main Doctor Biography & Credentials (7 Cols) -->
                <div class="lg:col-span-7 bg-ivory rounded-3xl p-6 md:p-8 border border-gold/30 shadow-sm flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-2 h-2 rounded-full bg-gold"></span>
                            <span class="font-label-caps text-gold text-[11px] font-bold tracking-[0.2em] uppercase">LE CHIRURGIEN SPÉCIALISTE</span>
                        </div>
                        
                        <h3 class="font-display-lg text-2xl sm:text-3xl font-bold text-primary mb-1">
                            Pr. Abdelfateh Slama
                        </h3>
                        <p class="font-headline-sm text-[11px] text-gold font-bold tracking-widest uppercase mb-4">
                            Chirurgien Esthétique à Sousse • Tunisie
                        </p>

                        <div class="space-y-2 text-primary/80 font-body-md text-xs sm:text-sm leading-relaxed">
                            <p class="font-medium text-primary">
                                Le Pr SLAMA est un chirurgien esthétique à Sousse - Tunisie. Il est spécialiste dans la chirurgie de la face et qualifié en chirurgie réparatrice et esthétique par le Collège Français en 2005.
                            </p>
                            <p>
                                Grâce à ses diplômes tunisiens et français et des années de formation au sein des plus grands centres hospitaliers et universitaires en Tunisie et en France, le Pr SLAMA a forgé une grande expérience, depuis les années 2000, et une expertise solide dans les domaines de la chirurgie esthétique, réparatrice et du visage.
                            </p>
                        </div>
                    </div>

                    <div class="pt-2 flex flex-wrap items-center gap-2">
                        <span class="px-3 py-1 rounded-full bg-white border border-gold/30 text-gold font-label-caps text-[9px] font-bold tracking-wider uppercase shadow-xs">
                            🎓 COLLÈGE FRANÇAIS 2005
                        </span>
                        <span class="px-3 py-1 rounded-full bg-white border border-gold/30 text-primary/80 font-label-caps text-[9px] font-bold tracking-wider uppercase shadow-xs">
                            📍 SOUSSE • TUNISIE
                        </span>
                    </div>
                </div>

                <!-- Bento Tile B: Surgeon at Work Spotlight (5 Cols) -->
                <div class="lg:col-span-5 bg-white rounded-3xl p-2.5 border border-gold/30 shadow-sm relative min-h-[300px] group overflow-hidden">
                    <div class="w-full h-full rounded-2xl overflow-hidden relative">
                        <img alt="Pr. Slama au bloc opératoire" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700" src="/images/dr_operating_real.png"/>
                        
                        <div class="absolute bottom-3 left-3 right-3 bg-white/95 backdrop-blur-md p-2.5 rounded-xl border border-gold/30 shadow-md text-center">
                            <span class="font-label-caps text-[8px] text-gold font-bold uppercase tracking-wider block">EXCELLENCE &amp; PRÉCISION AU BLOC</span>
                            <span class="font-body-md text-[11px] text-primary font-bold">Chirurgie Plastique &amp; Esthétique</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- BOTTOM BENTO ROW: 3 Highlight Tiles (4 Cols / 4 Cols / 4 Cols) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                
                <!-- Tile 1: Qualifications & Stats -->
                <div class="bg-white rounded-3xl p-5 border border-gold/25 shadow-xs hover:border-gold transition-all space-y-2">
                    <div class="w-8 h-8 rounded-xl bg-ivory border border-gold/30 flex items-center justify-center">
                        <span class="material-symbols-outlined text-gold text-lg">workspace_premium</span>
                    </div>
                    <h4 class="font-label-caps text-[10px] font-bold text-primary uppercase tracking-wider">EXPÉRIENCE &amp; QUALIFICATION</h4>
                    <p class="font-body-md text-[11px] text-primary/70 leading-relaxed">
                        Qualifié par le <strong>Collège Français (2005)</strong> et formé dans les CHU de Tunisie et de France depuis 2000.
                    </p>
                </div>

                <!-- Tile 2: Active Memberships (STCE & ISAPS) -->
                <div class="bg-white rounded-3xl p-5 border border-gold/25 shadow-xs hover:border-gold transition-all space-y-2">
                    <div class="w-8 h-8 rounded-xl bg-ivory border border-gold/30 flex items-center justify-center">
                        <span class="material-symbols-outlined text-gold text-lg">groups</span>
                    </div>
                    <h4 class="font-label-caps text-[10px] font-bold text-primary uppercase tracking-wider">MEMBRE ACTIF</h4>
                    <div class="space-y-1 text-[11px]">
                        <div class="flex items-center gap-1.5 text-primary/80">
                            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                            <span><strong>STCE</strong> (Société Tunisienne de Chirurgie Esthétique)</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-primary/80">
                            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                            <span><strong>ISAPS</strong> (International Society of Aesthetic Surgery)</span>
                        </div>
                    </div>
                </div>

                <!-- Tile 3: Direct Actions Bar -->
                <div class="bg-ivory rounded-3xl p-5 border border-gold/30 shadow-xs flex flex-col justify-between space-y-3">
                    <div>
                        <div class="w-8 h-8 rounded-xl bg-white border border-gold/30 flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-gold text-lg">calendar_month</span>
                        </div>
                        <h4 class="font-label-caps text-[10px] font-bold text-primary uppercase tracking-wider mb-0.5">CONSULTATION &amp; CONTACT</h4>
                        <p class="font-body-md text-[11px] text-primary/70">Prenez rendez-vous directement avec le Pr. Slama.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a asp-controller="Home" asp-action="About" class="flex-1 gold-gradient text-white py-2 px-3 rounded-full font-label-caps text-[10px] font-bold tracking-wider shadow hover:opacity-90 transition-all text-center block">
                            PARCOURS →
                        </a>
                        <a asp-controller="Home" asp-action="Contact" class="flex-1 bg-white border border-gold/40 text-primary py-2 px-3 rounded-full font-label-caps text-[10px] font-bold tracking-wider transition-all text-center block hover:border-gold">
                            RDV
                        </a>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>
<!-- END: LePraticien -->

<!-- BEGIN: ServicesBentoGrid (Clean 4-Card Grid Light Ivory Theme) -->
<section class="bg-ivory text-primary py-28 border-y border-gold/20 relative overflow-hidden">
    
    <div class="px-6 md:px-margin-desktop max-w-container-max mx-auto relative z-10">
        
        <!-- Header & Intro Section: Refined Medical Layout -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-16 gap-8 pb-10 border-b border-gold/15">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold/10 border border-gold/25 mb-4">
                    <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
                    <span class="font-label-caps text-gold tracking-[0.3em] text-[10px] uppercase font-bold">EXCELLENCE &amp; HAUTE CHIRURGIE</span>
                </div>
                <h2 class="font-display-lg text-4xl md:text-6xl text-primary font-bold leading-tight">
                    L'Art de la Transformation
                </h2>
                <p class="font-body-md text-primary/75 text-sm md:text-base leading-relaxed mt-3">
                    Des protocoles chirurgicaux et esthétiques d'exception alliant précision médicale et préservation absolue de votre identité naturelle.
                </p>
            </div>

            <div class="flex flex-wrap gap-2.5 items-center">
                <span class="font-label-caps text-[10px] bg-white text-gold px-4 py-2 border border-gold/30 rounded-full font-bold shadow-sm">
                    📍 SOUSSE, TUNISIE
                </span>
                <span class="font-label-caps text-[10px] gold-gradient text-white px-4 py-2 rounded-full font-bold shadow">
                    ⚡ ULTRASONS PIEZO HD
                </span>
                <span class="font-label-caps text-[10px] bg-white text-gold px-4 py-2 border border-gold/30 rounded-full font-bold shadow-sm">
                    ✨ 100% SUR-MESURE
                </span>
            </div>
        </div>

        <!-- Modern Medical Specialty Bento Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- CARD 01: Chirurgie du Visage (Spotlight Hero Card - 7 Cols) -->
            <div class="lg:col-span-7 group relative bg-white border border-teal-500/20 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col md:flex-row">
                <div class="md:w-1/2 relative aspect-[4/3] md:aspect-auto overflow-hidden bg-slate-100">
                    <img alt="Chirurgie du Visage" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/ch1.webp"/>
                    <div class="absolute top-4 left-4 z-10">
                        <span class="gold-gradient text-white font-label-caps text-[9px] px-3 py-1.5 rounded-full font-bold uppercase tracking-widest shadow">
                            PIEZO ULTRASONS HD
                        </span>
                    </div>
                </div>
                <div class="md:w-1/2 p-8 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-2 h-2 rounded-full bg-gold"></span>
                            <span class="font-label-caps text-gold text-[10px] uppercase font-bold tracking-widest">VISAGE &amp; COU</span>
                        </div>
                        <h3 class="font-display-lg text-2xl md:text-3xl font-bold text-primary mb-3">
                            Chirurgie Esthétique du Visage
                        </h3>
                        <p class="font-body-md text-xs text-slate-700 leading-relaxed mb-2 font-medium">
                            La chirurgie esthétique de la face et du cou permet de :
                        </p>
                        <ul class="font-body-md text-xs text-slate-600 space-y-1 mb-3 pl-4 list-disc marker:text-gold leading-relaxed">
                            <li>Rajeunir le visage,</li>
                            <li>Equilibrer et harmoniser la face, notamment le nez, les lèvres, les joues et les paupières,</li>
                        </ul>
                        <p class="font-body-md text-xs text-slate-600 leading-relaxed mb-6">
                            Les interventions les plus pratiquées sont : la rhinoplastie, le lifting cervico-facial, la blépharoplastie, la génioplastie, l’otoplastie et la liposuccion du double menton.
                        </p>
                    </div>
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="font-label-caps text-[10px] text-slate-400 font-semibold">SOUSSE • CLINIQUE</span>
                        <a asp-controller="Home" asp-action="Chirurgies" class="gold-gradient text-white px-5 py-2.5 rounded-full font-label-caps text-[10px] font-bold tracking-widest flex items-center gap-1.5 shadow hover:opacity-90 transition-all">
                            DÉTAILS <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- CARD 02: Médecine Esthétique (Featured Card - 5 Cols) -->
            <div class="lg:col-span-5 group relative bg-white border border-teal-500/20 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between">
                <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
                    <img alt="Médecine Esthétique" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/ch2.jpg"/>
                    <div class="absolute top-4 left-4 z-10">
                        <span class="gold-gradient text-white font-label-caps text-[9px] px-3 py-1.5 rounded-full font-bold uppercase tracking-widest shadow">
                            INJECTIONS &amp; SOINS
                        </span>
                    </div>
                </div>
                <div class="p-6 flex flex-col justify-between flex-1">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-2 h-2 rounded-full bg-gold"></span>
                            <span class="font-label-caps text-gold text-[10px] uppercase font-bold tracking-widest">MÉDECINE ESTHÉTIQUE</span>
                        </div>
                        <h3 class="font-display-lg text-2xl font-bold text-primary mb-2">
                            Médecine Esthétique
                        </h3>
                        <p class="font-body-md text-xs text-slate-600 leading-relaxed mb-4">
                            Sublimation des volumes du visage et traitement lissant par injections d'acide hyaluronique HD et Profhilo.
                        </p>
                    </div>
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="font-label-caps text-[10px] text-slate-400 font-semibold">SANS ÉVICTION</span>
                        <a asp-controller="Home" asp-action="Esthetique" class="gold-gradient text-white px-5 py-2.5 rounded-full font-label-caps text-[10px] font-bold tracking-widest flex items-center gap-1.5 shadow hover:opacity-90 transition-all">
                            DÉTAILS <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- CARD 03: Silhouette & Corps (6 Cols) -->
            <div class="lg:col-span-6 group relative bg-white border border-teal-500/20 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col md:flex-row">
                <div class="md:w-1/2 relative aspect-[4/3] md:aspect-auto overflow-hidden bg-slate-100">
                    <img alt="Silhouette &amp; Corps" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/silhouette_corps.jpg"/>
                    <div class="absolute top-4 left-4 z-10">
                        <span class="gold-gradient text-white font-label-caps text-[9px] px-3 py-1.5 rounded-full font-bold uppercase tracking-widest shadow">
                            ULTRASONS VASER
                        </span>
                    </div>
                </div>
                <div class="md:w-1/2 p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-2 h-2 rounded-full bg-gold"></span>
                            <span class="font-label-caps text-gold text-[10px] uppercase font-bold tracking-widest">CORPS &amp; SILHOUETTE</span>
                        </div>
                        <h3 class="font-display-lg text-2xl font-bold text-primary mb-2">
                            Silhouette &amp; Corps
                        </h3>
                        <p class="font-body-md text-xs text-slate-700 leading-relaxed mb-2">
                            La liposuccion ou lipoaspiration ou liposculpture intéresse l’excès de graisse jugé disgracieux surtout au niveau du ventre, hanches, cuisses, genoux, bras, dos.
                        </p>
                        <p class="font-body-md text-xs text-slate-600 leading-relaxed mb-2">
                            Le résultat est immédiat et on peut s’habiller en toute liberté et avec une nouvelle assurance.
                        </p>
                        <p class="font-body-md text-xs text-slate-600 leading-relaxed mb-4">
                            La liposuccion, selon les cas, est réalisée sous anesthésie générale ou locale, nécessite 24h d'hospitalisation et 5 à 7 jours de convalescence.
                        </p>
                    </div>
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="font-label-caps text-[10px] text-slate-400 font-semibold">HD SCULPT</span>
                        <a asp-controller="Home" asp-action="Chirurgies" class="gold-gradient text-white px-5 py-2.5 rounded-full font-label-caps text-[10px] font-bold tracking-widest flex items-center gap-1.5 shadow hover:opacity-90 transition-all">
                            DÉTAILS <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- CARD 04: Chirurgie Mammaire (6 Cols) -->
            <div class="lg:col-span-6 group relative bg-white border border-teal-500/20 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col md:flex-row">
                <div class="md:w-1/2 relative aspect-[4/3] md:aspect-auto overflow-hidden bg-slate-100">
                    <img alt="Chirurgie Mammaire" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/images/ch4.jpg"/>
                    <div class="absolute top-4 left-4 z-10">
