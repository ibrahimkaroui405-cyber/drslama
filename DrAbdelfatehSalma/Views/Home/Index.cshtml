    let currentResultModalIndex = 0;

    function openResultModal(index) {
        // Password guard
        if (!isResultsUnlocked()) {
            openResultsPasswordModal();
            return;
        }
        currentResultModalIndex = index;
        const data = galleryResultsData[index];
        if (!data) return;

        document.getElementById('modal-category').innerText = data.category;
        document.getElementById('modal-title').innerText = data.title;
        document.getElementById('modal-desc').innerText = data.desc;
        document.getElementById('modal-tag1').innerText = data.tag1;
        document.getElementById('modal-tag2').innerText = data.tag2;

        const beforeImg = document.getElementById('modal-before-img');
        const afterImg = document.getElementById('modal-after-img');
        const handle = document.getElementById('modal-ba-handle');

        if (beforeImg && afterImg && handle) {
            beforeImg.src = data.beforeImg;
            afterImg.src = data.afterImg;
            beforeImg.style.clipPath = 'inset(0 50% 0 0)';
            handle.style.left = '50%';
        }

        const modal = document.getElementById('result-modal');
        if (modal) {
            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
    }

    function closeResultModal() {
        const modal = document.getElementById('result-modal');
        if (modal) {
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function navigateModalResult(direction) {
        let newIndex = currentResultModalIndex + direction;
        if (newIndex < 0) newIndex = galleryResultsData.length - 1;
        if (newIndex >= galleryResultsData.length) newIndex = 0;
        openResultModal(newIndex);
    }

    function initModalSlider() {
        const slider = document.getElementById('modal-ba-slider');
        const beforeImg = document.getElementById('modal-before-img');
        const handle = document.getElementById('modal-ba-handle');
        let isDragging = false;

        if (!slider || !beforeImg || !handle) return;

        function setModalPos(clientX) {
            const rect = slider.getBoundingClientRect();
            let x = clientX - rect.left;
            if (x < 0) x = 0;
            if (x > rect.width) x = rect.width;
            const pct = (x / rect.width) * 100;
            beforeImg.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
            handle.style.left = pct + '%';
        }

        slider.addEventListener('mousedown', (e) => {
            isDragging = true;
            setModalPos(e.clientX);
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            setModalPos(e.clientX);
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        slider.addEventListener('touchstart', (e) => {
            isDragging = true;
            if (e.touches && e.touches[0]) setModalPos(e.touches[0].clientX);
        });

        window.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            if (e.touches && e.touches[0]) setModalPos(e.touches[0].clientX);
        });

        window.addEventListener('touchend', () => {
            isDragging = false;
        });
    }

    window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('result-modal');
        if (modal && !modal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
                closeResultModal();
            } else if (e.key === 'ArrowLeft') {
                navigateModalResult(-1);
            } else if (e.key === 'ArrowRight') {
                navigateModalResult(1);
            }
        }

        const vModal = document.getElementById('video-modal');
        if (vModal && !vModal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
                closeVideoModal();
            }
        }
    });

    // Video Testimonial Modal Controller
    function openVideoModal(videoSrc, title) {
        const modal = document.getElementById('video-modal');
        const modalTitle = document.getElementById('video-modal-title');
        const container = document.getElementById('index-video-container');

        if (modalTitle && title) {
            modalTitle.innerText = title;
        }

        if (container && videoSrc) {
            let isYouTube = videoSrc.includes('youtube.com') || videoSrc.includes('youtu.be');

            if (isYouTube) {
                let embedUrl = videoSrc;
                if (videoSrc.includes('watch?v=')) {
                    const parts = videoSrc.split('v=');
                    const vId = parts[1].split('&')[0];
                    embedUrl = 'https://www.youtube.com/embed/' + vId;
                } else if (videoSrc.includes('youtu.be/')) {
                    const parts = videoSrc.split('youtu.be/');
                    const vId = parts[1].split('?')[0];
                    embedUrl = 'https://www.youtube.com/embed/' + vId;
                }
                embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'autoplay=1&rel=0';

                container.innerHTML = `<iframe src="${embedUrl}" title="${title || 'Vidéo'}" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
            } else {
                container.innerHTML = `<video id="modal-video-player" controls autoplay class="w-full h-full object-contain">
                    <source src="${videoSrc}" type="video/mp4"/>
                    Votre navigateur ne supporte pas la lecture de vidéo.
                </video>`;
            }

            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            }
        }
    }

    function closeVideoModal() {
        const modal = document.getElementById('video-modal');
        const container = document.getElementById('index-video-container');

        if (container) {
            container.innerHTML = '';
        }

        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

