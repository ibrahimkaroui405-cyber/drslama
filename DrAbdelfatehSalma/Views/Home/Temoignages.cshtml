<div id="wrapper-actualites" class="hidden">
    <section class="py-16 px-6 md:px-margin-desktop bg-white border-b border-gold/20">
        <div class="max-w-container-max mx-auto">
            
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="font-label-caps text-[10px] tracking-[0.3em] text-gold font-bold block mb-2 uppercase">CHIRURGIE &amp; MÉDECINE ESTHÉTIQUE</span>
                <h2 class="font-display-lg text-3xl md:text-5xl font-bold text-primary">Actualités</h2>
                <p class="font-body-md text-primary/75 text-sm md:text-base mt-3 leading-relaxed">Découvrez les actualités et les nouveautés en chirurgie et médecine esthétique. A travers nos articles et nos expertises, nous vous aidons à mieux comprendre les traitements et les solutions adaptées à vos besoins.</p>
            </div>

            @{
                var actualites = ViewBag.Actualites as List<DrAbdelfatehSalma.Models.Actualite> ?? new List<DrAbdelfatehSalma.Models.Actualite>();
            }

            @if (actualites.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var news in actualites)
                    {
                        <a asp-controller="Home" asp-action="ActualiteDetail" asp-route-id="@news.Id" class="bg-white border border-gold/25 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-gold transition-all duration-300 flex flex-col justify-between group block cursor-pointer h-full">
                            <div class="relative w-full overflow-hidden bg-neutral-900 border-b border-gold/15">
                                @if (!string.IsNullOrEmpty(news.ImageUrl))
                                {
                                    <img src="@news.ImageUrl" alt="@news.Title" class="w-full h-auto block" />
                                }
                                else
                                {
                                    <div class="w-full h-48 flex items-center justify-center bg-[#0c0d10]">
                                        <span class="material-symbols-outlined text-gold text-4xl">newspaper</span>
                                    </div>
                                }
                                <span class="absolute top-3 left-3 gold-gradient text-white font-label-caps text-[8.5px] px-3 py-1 rounded-full font-bold uppercase shadow">
                                    @(news.IsFeatured ? "⭐ À LA UNE" : "ACTUALITÉ")
                                </span>
                            </div>
                            <div class="p-6 flex flex-col justify-between flex-1 space-y-4">
                                <div>
                                    <div class="flex items-center gap-2 text-gold text-[10px] font-label-caps font-bold mb-1">
                                        <span class="material-symbols-outlined text-xs">calendar_month</span>
                                        <span>@news.DateLabel</span>
                                    </div>
                                    <h4 class="font-display-lg text-xl font-bold text-primary mb-2 group-hover:text-gold transition-colors line-clamp-2">
                                        @news.Title
                                    </h4>
                                    <p class="font-body-md text-xs text-primary/75 leading-relaxed line-clamp-3">
                                        @news.Excerpt
                                    </p>
                                </div>
                                <div class="pt-3 border-t border-gold/15 flex items-center justify-between">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        @if (!string.IsNullOrEmpty(news.Tags))
                                        {
                                            foreach (var tag in news.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(2))
                                            {
                                                <span class="font-label-caps text-[9px] text-slate-500 font-bold uppercase bg-slate-100 px-2 py-0.5 rounded">@tag.Trim()</span>
                                            }
                                        }
                                    </div>
                                    <span class="font-label-caps text-[10px] font-bold text-gold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                                        LIRE <span class="material-symbols-outlined text-xs">arrow_forward</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-16 text-gray-400 italic">
                    Aucune actualité publiée pour le moment.
                </div>
            }

        </div>
    </section>
</div>


