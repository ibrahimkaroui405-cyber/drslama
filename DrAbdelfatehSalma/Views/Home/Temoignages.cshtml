@section Scripts {
<script>
    function filterPageTestimonials(type) {
        const cards = document.querySelectorAll('.page-testimonial-card');
        const tabs = document.querySelectorAll('.page-tab');

        tabs.forEach(tab => {
            tab.classList.remove('gold-gradient', 'text-white', 'shadow-md');
            tab.classList.add('bg-white', 'text-primary', 'border-gold/30');
        });

        if (event && event.currentTarget) {
            event.currentTarget.classList.remove('bg-white', 'text-primary', 'border-gold/30');
            event.currentTarget.classList.add('gold-gradient', 'text-white', 'shadow-md');
        }

        cards.forEach(card => {
            if (type === 'all' || card.dataset.type === type) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function openPageVideoModal(videoSrc, title) {
        const modal = document.getElementById('page-video-modal');
        const modalTitle = document.getElementById('page-video-title');
        const container = document.getElementById('page-video-container');

        if (modalTitle) modalTitle.textContent = title;

        let isYouTube = videoSrc.includes('youtube.com') || videoSrc.includes('youtu.be');

        if (isYouTube) {
            let embedUrl = videoSrc;
            if (videoSrc.includes('watch?v=')) {
                const parts = videoSrc.split('v=');
                const vId = parts[1].split('&')[0];
                embedUrl = 'https://www.youtube.com/embed/' + vId;
            } else if (videoSrc.includes('youtu.be/')) {
                const parts = videoSrc.split('youtu.be/');
                const vId = parts[1].split('?')[0];
                embedUrl = 'https://www.youtube.com/embed/' + vId;
            }
            embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'autoplay=1&rel=0';

            container.innerHTML = `<iframe src="${embedUrl}" title="${title || 'Vidéo'}" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
        } else {
            container.innerHTML = `<video id="page-video-player" controls autoplay class="w-full h-full object-contain">
                <source src="${videoSrc}" type="video/mp4"/>
                Votre navigateur ne supporte pas la lecture de vidéo.
            </video>`;
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }

    function closePageVideoModal() {
        const modal = document.getElementById('page-video-modal');
        const container = document.getElementById('page-video-container');
        if (container) container.innerHTML = '';
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
        document.body.classList.remove('overflow-hidden');
    }

    function openShareModal() {
        const modal = document.getElementById('share-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeShareModal() {
        const modal = document.getElementById('share-modal');
        modal.classList.remove('flex');
        modal.classList.add('hidden');
    }

    function handleShareSubmit(e) {
        e.preventDefault();
        const msg = document.getElementById('share-success-msg');
        msg.classList.remove('hidden');
        setTimeout(() => {
            closeShareModal();
            msg.classList.add('hidden');
        }, 2000);
    }

    function switchTemoignagesMainTab(tab) {
        const btnTem = document.getElementById('main-tab-temoignages');
        const btnAct = document.getElementById('main-tab-actualites');
        const wrapTem = document.getElementById('wrapper-temoignages');
        const wrapAct = document.getElementById('wrapper-actualites');

        if (tab === 'temoignages') {
            btnTem.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnAct.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            wrapTem.classList.remove('hidden');
            wrapAct.classList.add('hidden');
        } else {
            btnAct.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            btnTem.className = 'px-6 md:px-8 py-3.5 rounded-full font-label-caps text-[11px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center gap-2 whitespace-nowrap';
            wrapAct.classList.remove('hidden');
            wrapTem.classList.add('hidden');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const hash = window.location.hash;
        if (urlParams.get('tab') === 'actualites' || hash === '#actualites') {
            switchTemoignagesMainTab('actualites');
        }
    });


</script>
}
