@model IEnumerable<DrAbdelfatehSalma.Models.Temoignage>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Témoignages & Avis Patients — Dr. Abdelfateh Slama Sousse";
}

<!-- ============================================ -->
<!-- 1. HERO SECTION: DRAMATIC EDITORIAL SPLIT LAYOUT WITH COMPACT TRANSPARENT CTA CARD -->
<!-- ============================================ -->
<section class="relative min-h-[85vh] md:min-h-screen flex items-end md:items-center pt-24 md:pt-20 pb-16 md:pb-12 overflow-hidden bg-surface-container-low border-b border-gold/20">
    <!-- Right-Side Visual Container with Background Office Image & Floating Transparent Card on Desktop -->
    <div class="absolute inset-0 md:left-auto md:right-0 md:top-0 w-full md:w-1/2 h-full z-0 overflow-hidden bg-black flex items-center justify-center p-6 md:p-10">
        <!-- Office Background Image -->
        <img src="/images/office.png" alt="Cabinet Dr. Slama - Témoignages & Avis Sousse" class="absolute inset-0 w-full h-full object-cover object-center opacity-95 brightness-[1.0] transition-transform duration-[12s] hover:scale-105" />
        <div class="absolute inset-0 bg-black/10"></div>

        <!-- Desktop High-Fashion Gradient Transition -->
        <div class="hidden md:block absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-surface-container-low via-surface-container-low/50 to-transparent z-10 pointer-events-none"></div>
        <!-- Mobile Dark Gradient Overlay -->
        <div class="block md:hidden absolute inset-0 bg-gradient-to-t from-black/95 via-black/65 to-black/30 z-10 pointer-events-none"></div>

        <!-- Floating Transparent Glassmorphic Card (Ultra-transparent crystal glass) -->
        <div class="hidden md:block relative z-20 w-full max-w-sm sm:max-w-md bg-black/20 backdrop-blur-[2px] p-6 sm:p-8 rounded-2xl border border-white/40 shadow-xl text-center text-white my-auto">
            <span class="font-label-caps text-[8.5px] sm:text-[9px] tracking-[0.3em] text-white block mb-3 uppercase border border-white/50 inline-block px-3 py-1 bg-black/20 backdrop-blur-xs font-bold drop-shadow rounded-full">
                CONSULTATION PRIVÉE • SOUSSE
            </span>
            <h3 class="font-display-lg text-xl sm:text-2xl md:text-3xl font-bold text-white mb-2.5 leading-tight drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">
                Écrivons Ensemble Votre Propre Histoire
            </h3>
            <p class="font-body-md text-white/95 text-xs leading-relaxed max-w-xs sm:max-w-sm mx-auto drop-shadow-[0_1px_6px_rgba(0,0,0,0.9)] mb-5 font-medium">
                Prenez rendez-vous en cabinet à Sousse pour échanger sur vos souhaits en toute sérénité.
            </p>
            <div class="flex flex-wrap gap-2.5 justify-center items-center">
                <a asp-controller="Home" asp-action="Contact" class="bg-white hover:bg-neutral-100 text-primary font-label-caps text-[9.5px] tracking-wider px-5 py-2.5 rounded-full font-bold shadow-lg transition-all">
                    CONTACTEZ-NOUS
                </a>
                <a href="tel:+21673200000" class="border border-white/70 bg-black/30 backdrop-blur-xs text-white hover:bg-white hover:text-primary font-label-caps text-[9.5px] tracking-wider px-4 py-2.5 rounded-full font-bold shadow transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-xs">phone</span>
                    +216 73 200 000
                </a>
            </div>
        </div>
    </div>

    <!-- Content Area (Left Side: Editorial on Desktop, Clear High-Contrast on Mobile) -->
    <div class="relative z-20 w-full px-6 md:px-margin-desktop max-w-container-max mx-auto">
        <div class="w-full md:w-5/12 lg:w-[46%] max-w-lg p-0 text-white md:text-primary">
            <div class="flex items-center gap-3 mb-4">
                <span class="w-10 h-[1px] bg-gold"></span>
                <span class="font-label-caps text-gold block font-bold tracking-[0.3em] md:tracking-[0.4em] uppercase text-[9.5px] md:text-xs">
                    DR. ABDELFATEH SLAMA • SOUSSE
                </span>
            </div>
            <h1 class="font-display-lg text-5xl sm:text-6xl md:text-[85px] lg:text-[95px] leading-[0.92] md:leading-[0.88] tracking-tighter text-white md:text-primary mb-6 md:mb-8 italic">
                Vos<br/>
                <span class="not-italic font-black text-white md:text-primary">Témoignages</span>
            </h1>
            <p class="font-body-lg text-white/90 md:text-primary/80 text-sm md:text-base leading-relaxed">
                La satisfaction et la sérénité de nos patients sont la plus belle empreinte de notre travail. Découvrez leurs retours d'expérience et témoignages authentiques.
            </p>
            <!-- Mobile CTA Quick Buttons -->
            <div class="flex sm:hidden flex-col gap-2.5 pt-6">
                <a asp-controller="Home" asp-action="Contact" class="bg-gold hover:bg-[#a89060] text-white font-label-caps text-[10px] tracking-wider px-6 py-3 rounded-full font-bold shadow-lg transition-all text-center">
                    NOUS CONTACTER
                </a>
                <a href="tel:+21673200000" class="border border-white/40 bg-black/40 backdrop-blur-sm text-white font-label-caps text-[10px] tracking-wider px-5 py-2.5 rounded-full font-bold shadow transition-all flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-xs">phone</span>
                    +216 73 200 000
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator (Bottom Left) -->
    <div class="hidden sm:flex absolute bottom-10 left-6 md:left-margin-desktop items-center gap-4">
        <div class="h-16 w-[1px] bg-gold"></div>
        <span class="font-label-caps text-[10px] vertical-text text-gold font-bold" style="writing-mode: vertical-rl; transform: rotate(180deg);">SCROLL</span>
    </div>
</section>

<!-- ============================================ -->
<!-- MAIN PILLAR SWITCHER: TÉMOIGNAGES vs ACTUALITÉS -->
<!-- ============================================ -->
<div class="flex justify-center my-12 px-6">
    <div class="flex flex-col sm:flex-row gap-2 sm:gap-0 p-2 sm:p-1.5 rounded-3xl sm:rounded-full bg-ivory border border-gold/40 shadow-lg w-full sm:w-auto max-w-md sm:max-w-none">
        <button id="main-tab-temoignages" onclick="switchTemoignagesMainTab('temoignages')" class="w-full sm:w-auto px-4 md:px-8 py-3.5 rounded-2xl sm:rounded-full font-label-caps text-[10px] md:text-xs tracking-widest font-bold gold-gradient text-white shadow-md transition-all duration-300 flex items-center justify-center gap-2 whitespace-normal sm:whitespace-nowrap leading-tight">
            <span class="material-symbols-outlined text-xs md:text-sm shrink-0">rate_review</span>
            <span>1. TÉMOIGNAGES PATIENTS</span>
        </button>
        <button id="main-tab-actualites" onclick="switchTemoignagesMainTab('actualites')" class="w-full sm:w-auto px-4 md:px-8 py-3.5 rounded-2xl sm:rounded-full font-label-caps text-[10px] md:text-xs tracking-widest font-bold text-slate-700 hover:text-gold transition-all duration-300 flex items-center justify-center gap-2 whitespace-normal sm:whitespace-nowrap leading-tight">
            <span class="material-symbols-outlined text-xs md:text-sm shrink-0">newspaper</span>
            <span>2. ACTUALITÉS &amp; PRESSE</span>
        </button>
    </div>
</div>

<div id="wrapper-temoignages">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-container-max mx-auto px-6 mb-8">
            <div class="bg-emerald-50 border border-emerald-300 text-emerald-800 p-4 rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-600">check_circle</span>
                    <span class="font-body-md text-sm font-semibold">@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="max-w-container-max mx-auto px-6 mb-8">
            <div class="bg-rose-50 border border-rose-300 text-rose-800 p-4 rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-rose-600">error</span>
                    <span class="font-body-md text-sm font-semibold">@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.parentElement.remove()" class="text-rose-600 hover:text-rose-800">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>
    }

    <!-- ============================================ -->
    <!-- 2. VERIFIED RATING & OVERALL SATISFACTION METRICS (DYNAMIC DATABASE METRICS) -->
    <!-- ============================================ -->
    @{
        var testimonialsList = Model?.ToList() ?? new List<DrAbdelfatehSalma.Models.Temoignage>();
        var totalReviews = testimonialsList.Count;
        var avgScore = totalReviews > 0 ? testimonialsList.Average(t => (double)(t.Rating > 0 ? t.Rating : 5)) : 5.0;
        var avgScoreFormatted = avgScore.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        var roundedScore = (int)Math.Round(avgScore);

        var ecouteScore = totalReviews > 0 ? Math.Min(5.0, Math.Round(avgScore * 1.0, 1)) : 5.0;
        var naturelScore = totalReviews > 0 ? Math.Min(5.0, Math.Round(avgScore * 1.0, 1)) : 5.0;
        var suiviScore = totalReviews > 0 ? Math.Min(5.0, Math.Round(avgScore * 1.0, 1)) : 5.0;

        var ecouteFormatted = ecouteScore.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        var naturelFormatted = naturelScore.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        var suiviFormatted = suiviScore.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

        var ecoutePct = (int)Math.Round((ecouteScore / 5.0) * 100);
        var naturelPct = (int)Math.Round((naturelScore / 5.0) * 100);
        var suiviPct = (int)Math.Round((suiviScore / 5.0) * 100);

        var featuredStory = testimonialsList.FirstOrDefault(t => t.IsFeatured) 
                            ?? testimonialsList.FirstOrDefault(t => t.Type == "video") 
                            ?? testimonialsList.FirstOrDefault();
    }
    <section class="py-16 px-6 md:px-margin-desktop bg-white border-b border-gold/20">
        <div class="max-w-container-max mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white p-8 md:p-12 border border-gold/20 shadow-sm">
            
                <div class="lg:col-span-4 text-center lg:text-left border-b lg:border-b-0 lg:border-r border-gold/20 pb-8 lg:pb-0 lg:pr-8">
                    <div class="flex items-center justify-center lg:justify-start gap-2 mb-2">
                        <span class="font-display-lg text-6xl font-black text-primary">@avgScoreFormatted</span>
                        <span class="text-2xl text-primary/40 font-light">/ 5.0</span>
                    </div>
                    <div class="flex justify-center lg:justify-start gap-1 text-gold mb-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= roundedScore)
                            {
                                <span class="material-symbols-outlined text-xl fill-1">star</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-xl text-neutral-300">star</span>
                            }
                        }
                    </div>
                    <p class="font-label-caps text-xs font-bold text-primary">AVIS PATIENTS CERTIFIÉS</p>
                    <p class="font-body-md text-xs text-primary/60 mt-1">
                        @if (totalReviews > 0)
                        {
                            <span>Basé sur @totalReviews avis patient@(totalReviews > 1 ? "s" : "") vérifié@(totalReviews > 1 ? "s" : "") et suivi@(totalReviews > 1 ? "s" : "") en cabinet à Sousse.</span>
                        }
                        else
                        {
                            <span>Évaluations indépendantes et suivis cliniques au cabinet.</span>
                        }
                    </p>
                </div>

                <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left">
                    <div class="p-4 bg-white border border-gold/20">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-label-caps text-[10px] font-bold text-primary">ÉCOUTE & PRÉPARATOIRE</span>
                            <span class="font-bold text-gold text-xs">@ecouteFormatted / 5</span>
                        </div>
                        <div class="w-full h-1.5 bg-neutral-200 overflow-hidden">
                            <div class="h-full gold-gradient transition-all duration-700" style="width: @(ecoutePct)%;"></div>
                        </div>
                        <p class="font-body-md text-[11px] text-primary/60 mt-2">Prise en compte des souhaits & consultations approfondies.</p>
                    </div>

                    <div class="p-4 bg-white border border-gold/20">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-label-caps text-[10px] font-bold text-primary">NATUREL DES RÉSULTATS</span>
                            <span class="font-bold text-gold text-xs">@naturelFormatted / 5</span>
                        </div>
                        <div class="w-full h-1.5 bg-neutral-200 overflow-hidden">
                            <div class="h-full gold-gradient transition-all duration-700" style="width: @(naturelPct)%;"></div>
                        </div>
                        <p class="font-body-md text-[11px] text-primary/60 mt-2">Respect des harmonies du visage et discrétion des gestes.</p>
                    </div>

                    <div class="p-4 bg-white border border-gold/20">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-label-caps text-[10px] font-bold text-primary">SUIVI POST-OPÉRATOIRE</span>
                            <span class="font-bold text-gold text-xs">@suiviFormatted / 5</span>
                        </div>
                        <div class="w-full h-1.5 bg-neutral-200 overflow-hidden">
                            <div class="h-full gold-gradient transition-all duration-700" style="width: @(suiviPct)%;"></div>
                        </div>
                        <p class="font-body-md text-[11px] text-primary/60 mt-2">Présence constante et disponibilité d'urgence 24/7.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- 3. FEATURED PATIENT STORY SPOTLIGHT (DYNAMIC) -->
    <!-- ============================================ -->
    @if (featuredStory != null)
    {
        var featName = string.IsNullOrWhiteSpace(featuredStory.PatientName) ? "Caroline B." : featuredStory.PatientName;
        var featInfo = string.IsNullOrWhiteSpace(featuredStory.PatientInfo) ? "RHINOPLASTIE ULTRASONIQUE • SOUSSE" : featuredStory.PatientInfo;
        var featQuote = string.IsNullOrWhiteSpace(featuredStory.Quote) ? "Retrouver l'harmonie de mon visage tout en me sentant 100% moi-même." : featuredStory.Quote;
        var featFollowUp = string.IsNullOrWhiteSpace(featuredStory.FollowUpTime) ? "SUIVI À 12 MOIS POST-OPÉRATOIRE" : featuredStory.FollowUpTime;
        var featImage = string.IsNullOrWhiteSpace(featuredStory.ImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=1000" : featuredStory.ImageUrl;
        var featVideo = string.IsNullOrWhiteSpace(featuredStory.VideoUrl) ? "/videos/tem.mp4" : featuredStory.VideoUrl;
        var isVideoFeat = featuredStory.Type == "video" || !string.IsNullOrWhiteSpace(featuredStory.VideoUrl);

        <section class="py-20 px-6 md:px-margin-desktop bg-white border-b border-gold/20">
            <div class="max-w-container-max mx-auto">
                
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="font-label-caps text-[10px] tracking-[0.3em] text-gold font-bold block mb-3 uppercase">RÉCIT EN VEDETTE</span>
                    <h2 class="font-display-lg text-4xl md:text-5xl font-bold text-primary">L'Histoire de @featName</h2>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-white border border-gold/20 shadow-xl p-8 md:p-12">
                    
                    <div class="lg:col-span-6 relative">
                        <div class="relative aspect-[16/10] overflow-hidden gold-border-light group cursor-pointer" onclick="@(isVideoFeat ? $"openPageVideoModal('{featVideo}', '{featName} — {featInfo}')" : "")">
                            <img src="@featImage" alt="Témoignage @featName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                            @if (isVideoFeat)
                            {
                                <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors flex items-center justify-center">
                                    <div class="w-20 h-20 rounded-full gold-gradient text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                                        <span class="material-symbols-outlined text-4xl">play_arrow</span>
                                    </div>
                                </div>
                                <span class="absolute bottom-4 right-4 bg-black/90 text-white font-label-caps text-[10px] px-3 py-1.5 flex items-center gap-1 font-bold">
                                    <span class="material-symbols-outlined text-sm text-gold">videocam</span> VIDÉO HD
                                </span>
                            }
                        </div>
                    </div>

                    <div class="lg:col-span-6 space-y-6">
                        <span class="font-label-caps text-[10px] gold-gradient text-white px-3 py-1 font-bold uppercase tracking-widest inline-block shadow">
                            @featInfo.ToUpper()
                        <h3 class="font-display-lg text-2xl md:text-4xl font-bold text-primary leading-tight">
                            "@featQuote"
                        </h3>
                        <div class="border-t border-gold/20 pt-4 flex items-center justify-between">
                            <div>
                                <p class="font-label-caps text-xs font-bold text-primary">@featName.ToUpper()</p>
                                <p class="font-label-caps text-[9px] text-gold font-bold">@featFollowUp.ToUpper()</p>
                            </div>
                            @if (isVideoFeat)
                            {
                                <button onclick="openPageVideoModal('@featVideo', '@featName — @featInfo')" class="gold-gradient text-white font-label-caps text-[10px] px-6 py-3 hover:opacity-90 transition-all font-bold tracking-widest flex items-center gap-2 shadow">
                                    <span class="material-symbols-outlined text-sm">play_circle</span> REGARDER LE RÉCIT VIDÉO
                                </button>
                            }
                            else
                            {
                                <div class="flex gap-1 text-gold">
                                    @for (int i = 0; i < (featuredStory.Rating > 0 ? featuredStory.Rating : 5); i++)
                                    {
                                        <span class="material-symbols-outlined text-sm fill-1">star</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>

            </div>
        </section>
    }

<!-- ============================================ -->
<!-- 4. MAIN TESTIMONIALS CATALOG GRID (PRESERVED CARD DESIGN) -->
<!-- ============================================ -->
<section class="py-section-gap px-6 md:px-margin-desktop max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6">
        <div>
            <span class="font-label-caps text-gold font-bold block mb-4 uppercase">RETOURS D'EXPÉRIENCE PATIENTS</span>
            <h2 class="font-display-lg text-4xl md:text-6xl font-bold text-primary">Vidéos & Avis Écrits</h2>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button onclick="filterPageTestimonials('all')" class="page-tab active px-5 py-2.5 font-label-caps text-xs gold-gradient text-white font-bold transition-all shadow-md">TOUT VOIR</button>
            <button onclick="filterPageTestimonials('video')" class="page-tab px-5 py-2.5 font-label-caps text-xs bg-white border border-gold/30 text-primary hover:border-gold hover:text-gold transition-all">VIDÉOS 🎥</button>
            <button onclick="filterPageTestimonials('text')" class="page-tab px-5 py-2.5 font-label-caps text-xs bg-white border border-gold/30 text-primary hover:border-gold hover:text-gold transition-all">AVIS ÉCRITS ✍️</button>
            <button onclick="openShareModal()" class="px-5 py-2.5 font-label-caps text-xs bg-primary text-gold border border-gold hover:bg-gold hover:text-white transition-all font-bold shadow-sm flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">edit_square</span> LAISSER UN AVIS
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                if (item.Type == "video")
                {
                    <div class="page-testimonial-card group editorial-border overflow-hidden bg-white relative" data-type="video">
                        <div class="relative aspect-[16/9] overflow-hidden cursor-pointer" onclick="openPageVideoModal('@(string.IsNullOrEmpty(item.VideoUrl) ? "/videos/tem.mp4" : item.VideoUrl)', '@item.PatientName — @item.PatientInfo')">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=800" : item.ImageUrl)" alt="@item.PatientName" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"/>
                            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                <div class="w-16 h-16 rounded-full bg-white text-black flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-3xl">play_arrow</span>
                                </div>
                            </div>
                            <span class="absolute bottom-3 right-3 bg-black/80 text-white font-label-caps text-[9px] px-2 py-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">videocam</span> @(string.IsNullOrEmpty(item.FollowUpTime) ? "Suivi certifié" : item.FollowUpTime)
                            </span>
                            <span class="absolute top-3 left-3 bg-black text-white font-label-caps text-[9px] px-3 py-1 font-bold">TÉMOIGNAGE VIDÉO</span>
                        </div>
                        <div class="p-6">
                            <p class="font-quote text-base italic text-primary leading-relaxed mb-4">"@item.Quote"</p>
                            <div class="flex justify-between items-center border-t border-black/10 pt-4">
                                <div>
                                    <p class="font-label-caps text-xs font-bold">@item.PatientName.ToUpper()</p>
                                    <p class="font-label-caps text-[9px] text-primary/40">@item.PatientInfo.ToUpper()</p>
                                </div>
                                <button onclick="openPageVideoModal('@(string.IsNullOrEmpty(item.VideoUrl) ? "/videos/tem.mp4" : item.VideoUrl)', '@item.PatientName — @item.PatientInfo')" class="font-label-caps text-[9px] font-bold underline hover:opacity-70 flex items-center gap-1">
                                    REGARDER LA VIDÉO <span class="material-symbols-outlined text-xs">play_circle</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="page-testimonial-card editorial-border p-8 flex flex-col justify-between bg-white" data-type="text">
                        <div>
                            <div class="flex justify-between items-center mb-6">
                                <div class="flex gap-1 text-gold">
                                    @for (int i = 0; i < (item.Rating > 0 ? item.Rating : 5); i++)
                                    {
                                        <span class="material-symbols-outlined text-sm fill-1">star</span>
                                    }
                                </div>
                                <span class="font-label-caps text-[9px] bg-black/5 px-2 py-1">AVIS ÉCRIT</span>
                            </div>
                            <p class="font-quote text-lg italic leading-relaxed text-primary mb-8">
                                "@item.Quote"
                            </p>
                        </div>
                        <div class="border-t border-black/10 pt-6">
                            <p class="font-label-caps text-xs font-bold">@item.PatientName.ToUpper()</p>
                            <p class="font-label-caps text-[10px] text-primary/40">@item.PatientInfo.ToUpper()</p>
                        </div>
                    </div>
                }
            }
        }
        else
        {
